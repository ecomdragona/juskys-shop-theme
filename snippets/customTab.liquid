{% comment %}
<style>
  .collapsibles-wrapper.custom.collapsibles-wrapper--border-bottom {
    margin-top: 0px !important;
  }
  .collapsible-trigger-btn.custom.collapsible-trigger-btn--borders {
    margin-top: 0px !important;
  }
  .collapsible-content {
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<section>
  {% assign output_tab = true %}

  {% if title == blank %}
    {% assign output_tab = false %}
  {% endif %}

  {% if block.settings.variant_metafield != blank %}
    {% assign metafields = block.settings.variant_metafield | split: '.' %}
    {% assign namespace = metafields | first %}
    {% assign key = metafields | last %}
  {% endif %}

  {%- if output_tab -%}
    <div id="Variant-content-{{variant.id}}" class="collapsibles-wrapper custom collapsibles-wrapper--border-bottom">
      <button
        type="button"
        onclick="changeIcon(this)"
        class="tab label collapsible-trigger collapsible-trigger-btn custom collapsible-trigger-btn--borders collapsible--auto-height{% if force_open %} is-open{% endif %}"
        aria-controls="Product-content-{{ id }}"
        {% if force_open %}
          aria-expanded="true"
        {% endif %}
      >
        <span class="spacing">{{ title }}</span>
        {%- render 'collapsible-icons', icon: icon -%}
      </button>
      <div
        id="Product-content-{{ id }}"
        class="collapsible-content collapsible-content--all custom{% if force_open %} is-open{% endif %}"
      >
        <div class="collapsible-content__inner rte">
          {% assign metafield_content = '' %}
          {% if block.settings.variant_metafield != blank %}
            {% assign metafields = block.settings.variant_metafield | split: '.' %}
            {% if metafields.size == 2 %}
              {% assign namespace = metafields[0] %}
              {% assign key = metafields[1] %}
              {% assign variant = product.selected_or_first_available_variant %}
              {% if variant.metafields[namespace] and variant.metafields[namespace][key] %}
                {% capture metafield_content %}
                {{ variant.metafields[namespace][key] | metafield_tag }}
              {% endcapture %}
              {% endif %}
            {% endif %}
          {% endif %}
          {% if metafield_content != blank %}
            {{ metafield_content | remove_first: '<p>' | remove_first: '</p>' }}
          {% endif %}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>
{% endcomment %}

<style>
    .collapsibles-wrapper.custom.collapsibles-wrapper--border-bottom {
      margin-top: 0px !important;
  }
    .collapsible-trigger-btn.custom.collapsible-trigger-btn--borders{
      margin-top: 0px !important;
    }
    .collapsible-content.collapsible-content--all.custom.is-open {
      height: auto !important;
  }
</style>
{%- liquid
  assign output_tab = true
  if title == blank
    assign output_tab = false
  endif
-%}
{% if block.settings.variant_metafield != blank %}
  {% assign metafields = block.settings.variant_metafield | split: '.' %}
  {% assign namespace = metafields | first %}
  {% assign key = metafields | last %}
{% endif %}
{%- if output_tab -%}
  <div id="Variant-content-{{variant.id}}" class="collapsibles-wrapper custom collapsibles-wrapper--border-bottom">
    <button
      type="button"
      onclick="changeIcon(this)"
      class="tab label collapsible-trigger collapsible-trigger-btn custom collapsible-trigger-btn--borders collapsible--auto-height{% if force_open %} is-open{% endif %}"
      aria-controls="Product-content-{{ id }}"
      
    >
      <span class="spacing">{{ title }}</span>
      {%- render 'collapsible-icons', icon: icon -%}
    </button>
    <div
      id="Product-content-{{ id }}"
      class="collapsible-content collapsible-content--all custom{% if force_open %} is-open{% endif %}"
      {% if force_open %}
        style="height: auto;"
      {% endif %}
    >
      <div class="collapsible-content__inner rte">
        {% for variant in product.variants %}
          <div
            id="Variant-{{variant.id}}"
            {% if product.selected_or_first_available_variant != variant %}
              style="display:none"
            {% endif %}
            data-tab-variant
          >
            {% capture content -%}
                    {{variant.metafields[namespace][key] | metafield_tag }}
                    {%- endcapture %}
            {{ content | remove_first: '<p>' | remove_first: '</p>' }}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{%- endif -%}
