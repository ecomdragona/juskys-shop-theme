    <div class="psy-popup-content">
      <div class="psy-popup-image">
        <div class="product_title_mobile">
          <h2 class="psy-popup-product-title">{{ product.title }}</h2>
          {%- for block in blocks -%}
            {%- if block.type == 'text' -%}
              <div class="psy-popup-subtitle" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div id="model-container">
          <div id="loading">Loading model...</div>
          <div id="error" style="display: none;"></div>
        </div>
      </div>
      <div class="psy-popup-text">
        <div class="psy-popup-text-first">
          <h2 class="psy-popup-product-title desk_componant">{{ product.title }}</h2>
          {%- for block in blocks -%}
            {%- if block.type == 'text' -%}
              <div class="psy-popup-subtitle desk_componant" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {% endif %}
          {% endfor %}
          {% if product.variants.size > 1 %}
            <div class="psy-variant-selector">
              {% for option in product.options_with_values %}
                <div class="psy-variant-group psy-variant-group-{{ option.name | handleize }}">
                  <p>{{ option.name }}:</p>
                  <div class="psy-variant-group-values">
                    {% for value in option.values %}
                      <div class="psy-variant-radio">
                        <input
                          type="radio"
                          name="option_{{ forloop.parentloop.index }}"
                          value="{{ value }}"
                          id="option_{{ forloop.parentloop.index }}_{{ forloop.index }}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          {% if forloop.index == 1 %}
                            checked
                          {% endif %}
                        >
                        {%- assign swatch_file_extension = 'png' -%}
                        {%- liquid
                          assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
                          assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                          assign color_swatch_fallback = value | split: ' ' | last | handle
                        -%}
                        {% if option.name == 'Farben' %}
                          <label
                            for="option_{{ forloop.parentloop.index }}_{{ forloop.index }}"
                            class="color-variants"
                            style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %} background-image: url({{ color_image }});{% endif %}"
                          ></label>
                        {% else %}
                          <label
                            class="auther-variants"
                            for="option_{{ forloop.parentloop.index }}_{{ forloop.index }}"
                          >
                            {{- value -}}
                          </label>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
              {% for variant in product.variants %}
                <input
                  type="hidden"
                  data-variant-id="{{ variant.id }}"
                  value="{{ variant.metafields.custom.three_dimensional_image.value }}"
                >
              {% endfor %}
            </div>
          {% endif %}
        </div>
        <div class="psy-popup-text-atc">
          <button class="psy-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
            {{ 'products.product.add_to_cart' | t }}
          </button>
          <div class="psy-cart-error" id="cart-error"></div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/loaders/GLTFLoader.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const openBtn = document.querySelector('.psy-custom3dmodle');
      const overlay = document.getElementById('overlay');
      const popup = document.getElementById('popup');
      const closeBtn = document.getElementById('close-popup-btn');
      const body = document.body;
      let currentModel = null;

      openBtn.addEventListener('click', () => {
        overlay.style.display = 'block';
        popup.style.display = 'block';
        body.classList.add('popup-open', 'psy-popup-active');
        setTimeout(()=>{
          document.querySelector('.psy-variant-radio label').click()
        },200)
        resetVariantSelections();
        init3DModel();
      });

      function closePopup() {
        overlay.style.display = 'none';
        popup.style.display = 'none';
        body.classList.remove('popup-open', 'psy-popup-active');
        if (currentModel) {
          currentModel.scene.remove(currentModel.model);
          currentModel = null;
        }
      }

      if (overlay) {
        overlay.addEventListener('click', closePopup);
      } 
      if (closeBtn) {
        closeBtn.addEventListener('click', closePopup);
      } 
      function init3DModel(variantId = '{{ product.selected_or_first_available_variant.id }}') {
        const container = document.getElementById('model-container');
        while (container.firstChild) {
          container.removeChild(container.firstChild);
        }
        container.dataset.initialized = 'true';
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0xF7F7F7);
        const camera = new THREE.PerspectiveCamera(75, container.clientWidth / 300, 0.1, 1000);
        camera.position.set(0, 2, 5);
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(container.clientWidth, 350);
        container.appendChild(renderer.domElement);
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 0.6);
        directionalLight.position.set(5, 5, 5);
        scene.add(directionalLight);
        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.minDistance = 2;
        controls.maxDistance = 10;
        const loadingDiv = document.getElementById('loading');
        const errorDiv = document.getElementById('error');
        loadingDiv.style.display = 'block';
        errorDiv.style.display = 'none';
        const glbInput = document.querySelector(`input[data-variant-id="${variantId}"]`);
        const glbUrl = glbInput ? glbInput.value : '';
        if (!glbUrl) {
          loadingDiv.style.display = 'none';
          errorDiv.style.display = 'block';
          errorDiv.textContent = 'No 3D model available for this variant.';
          return;
        }
        const loader = new THREE.GLTFLoader();
        loader.load(
          glbUrl,
          (gltf) => {
            const model = gltf.scene;
            scene.add(model);
            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            const maxDim = Math.max(size.x, size.y, size.z);
            const scale = (3 / maxDim) * 3;
            model.scale.set(scale, scale, scale);
            model.position.sub(center.multiplyScalar(scale));
            loadingDiv.style.display = 'none';
            camera.lookAt(model.position);
            currentModel = { scene, model };
          },
          (xhr) => {
            const percent = (xhr.loaded / xhr.total * 100).toFixed(2);
            loadingDiv.textContent = `Loading model... ${percent}%`;
          },
          (error) => {
            loadingDiv.style.display = 'none';
            errorDiv.style.display = 'block';
            errorDiv.textContent = 'Failed to load model.';
          }
        );
        function animate() {
          requestAnimationFrame(animate);
          controls.update();
          renderer.render(scene, camera);
        }
        animate();
        const onResize = () => {
          renderer.setSize(container.clientWidth, 300);
          camera.aspect = container.clientWidth / 300;
          camera.updateProjectionMatrix();
        };
        window.addEventListener('resize', onResize);
        if (!renderer.capabilities.isWebGL2 && !renderer.capabilities.isWebGL1) {
          loadingDiv.style.display = 'none';
          errorDiv.style.display = 'block';
          errorDiv.textContent = 'WebGL is not supported in this browser.';
        }
      }

      function resetVariantSelections() {
        const variantGroups = document.querySelectorAll('.psy-variant-group');
        variantGroups.forEach(group => {
          const firstRadio = group.querySelector('.psy-variant-radio input[type="radio"]');
          if (firstRadio) {
            firstRadio.checked = true;
          }
        });
        const changeEvent = new Event('change');
        const variantSelector = document.querySelector('.psy-variant-selector');
        if (variantSelector) {
          variantSelector.dispatchEvent(changeEvent);
        } 
      }

      const variantSelector = document.querySelector('.psy-variant-selector');
      const addToCartBtn = document.querySelector('.psy-add-to-cart');
      const cartError = document.getElementById('cart-error');
      let selectedVariantId = '{{ product.selected_or_first_available_variant.id }}';
      const productVariants = {{ product.variants | json }};

      if (!addToCartBtn) {
        console.error('Debug: Add to Cart button (.psy-add-to-cart) not found.');
        return;
      }

      function updateSelectedVariant() {
        const selectedOptions = [];
        document.querySelectorAll('.psy-variant-radio input:checked').forEach(input => {
          selectedOptions.push(input.value);
        });

        const selectedVariant = productVariants.find(variant => {
          return variant.options.every((option, index) => option === selectedOptions[index]);
        });

        if (selectedVariant) {
          selectedVariantId = selectedVariant.id;
          addToCartBtn.dataset.variantId = selectedVariantId;
          addToCartBtn.disabled = !selectedVariant.available;
          cartError.style.display = 'none';
          if (!selectedVariant.available) {
            cartError.style.display = 'block';
            cartError.textContent = 'Selected variant is out of stock.';
          } else {
            init3DModel(selectedVariantId);
          }
        } else {
          addToCartBtn.disabled = true;
          cartError.style.display = 'block';
          cartError.textContent = 'Selected variant is not available.';
        }
      }

      if (variantSelector) {
        variantSelector.addEventListener('change', updateSelectedVariant);
        updateSelectedVariant();
      } 

      addToCartBtn.addEventListener('click', async () => {
        if (addToCartBtn.disabled) {
          return;
        }

        addToCartBtn.disabled = true;
        addToCartBtn.textContent = 'wird hinzugefügt';

        try {
          const variantIdNum = parseInt(selectedVariantId);
          if (isNaN(variantIdNum)) {
            throw new Error('Invalid variant ID');
          }
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: variantIdNum,
                quantity: 1
              }]
            })
          });
          const data = await response.json();

          addToCartBtn.disabled = false;
          addToCartBtn.textContent = 'Add to Cart';

          if (!response.ok || data.status === 'error') {
            cartError.style.display = 'block';
          } else {
            cartError.style.display = 'none';
            document.dispatchEvent(new CustomEvent('cart:build'));
            openCartDrawer()
            closePopup();
          }
        } catch (error) {
          addToCartBtn.disabled = false;
          addToCartBtn.textContent = 'Add to Cart';
          cartError.style.display = 'block';
        }
      });
    });
function openCartDrawer() {
  const cartDrawer = document.getElementById('CartDrawer');
  if (!cartDrawer) return;

  cartDrawer.classList.add('drawer--is-open');
  document.documentElement.classList.add('js-drawer-open', 'lock-scroll');

  function handleOutsideClick(e) {
    const isInsideDrawer = e.target.closest('#CartDrawer');
    const isCloseBtn = e.target.closest('.js-drawer-close');

    if (!isInsideDrawer || isCloseBtn) {
      cartDrawer.classList.remove('drawer--is-open');
      document.documentElement.classList.remove('js-drawer-open', 'lock-scroll');
      window.removeEventListener('click', handleOutsideClick);
    }
  }

  window.addEventListener('click', handleOutsideClick);
}



  </script>
{% endif %}
