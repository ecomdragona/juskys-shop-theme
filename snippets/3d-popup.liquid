{% if product.metafields.custom.three_dimensional_image != blank %}
  <style>
    .product-single__sticky{
      z-index: 5;
    }
    .psy-popup-active .product-section, .psy-popup-active .main-product-container{
      z-index: 1001;
      position: relative;
    }
    .psy-variant-selector {
      margin-top: 20px;
    }
    .psy-variant-group {
      margin-bottom: 15px;
    }
    .psy-variant-group p {
      margin-bottom:8px;
      font-size: 14px;
      font-weight: 400;
      line-height: 16.32px;
      letter-spacing: 4.08px;
      text-transform: uppercase;
    }
    .psy-variant-radio {
      display: flex;
      align-items: center;
    }
    .psy-variant-radio input[type="radio"] {
      display: none;
    }
    .psy-variant-radio label.color-variants {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      margin: 0;
      display: inline-block;
      vertical-align: middle;
      cursor: pointer;
      border: 2px solid #ccc;
      background-size: cover;
      background-position: center;
      transition: border-color 0.2s, transform 0.2s;
    }
    .psy-variant-radio input[type="radio"]:checked + label.color-variants {
      border: 2px solid #333;
      box-shadow: 0 0 0 2px #fff inset;
    }
    .psy-variant-radio label.color-variants:hover {
      border: 2px solid #666;
      transform: scale(1.1);
    }
    .psy-variant-radio label.auther-variants {
      font-size: 14px;
      line-height: 20px;
      vertical-align: middle;
      cursor: pointer;
      padding: 4px 8px;
      border: 2px solid #ccc;
      border-radius: 2px;
      transition: border-color 0.2s, background-color 0.2s;
    }
    .psy-variant-radio input[type="radio"]:checked + label.auther-variants {
      border: 2px solid #000;
      background-color: #f5f5f5;
    }
    .psy-variant-radio label.auther-variants:hover {
      border-color: #666;
    }
    .psy-add-to-cart {
      display: inline-block;
      background: var(--colorBtnPrimary);
      border: none;
      border-radius: 0px;
      cursor: pointer;
      color: #FFF;
      text-align: center;
      font-size: 13px;
      font-weight: 700;
      line-height: 18.46px; /* 142% */
      letter-spacing: 3.9px;
      text-transform: uppercase;
      height:49px;
      width:100%;
    }
    .psy-add-to-cart:disabled {
      background: #cccccc;
      cursor: not-allowed;
    }
    .psy-cart-error {
      color: red;
      font-size: 14px;
      margin-top: 10px;
      display: none;
    }
    body.popup-open {
      overflow: hidden;
    }
    body.popup-open > *:not(.psy-overlay):not(.psy-popup) {
      pointer-events: none;
    }
    .psy-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      z-index: 10000;
      pointer-events: auto;
    }
    .psy-popup {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: white;
      border-radius: 2px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      z-index: 10001;
      max-width: 100%;
      width: 88%;
      pointer-events: auto;
      height: 85%;
    }
    .psy-popup-content {
      display: flex;
      align-items: center;
      height: 100%;
      position:relative;
    }
    .psy-popup-image {
      max-width: 72%;
      width: 100%;
      background: #F7F7F7;
      height: 100%;
      display: flex;
      align-items: center;
    }
    .psy-popup-text {
      padding: 40px 24px 24px 24px;
      max-width: 28%;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    #model-container {
      width: 100%;
      /* height: 100%; */
      overflow: hidden;
      position: relative;
    }
    #model-container canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }
    #loading {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #333;
      font-size: 16px;
    }
    .psy-close-btn {
      position: absolute;
      top: 16px;
      right: 24px;
      background: transparent;
      color: #333;
      border: none;
      font-size: 20px;
      font-weight: bold;
      cursor: pointer;
      padding: 0;
      line-height: 1;
      transition: color 0.2s;
      z-index: 111;
    }
    .psy-close-btn:hover {
      color: #ff4d4d;
    }
    #error {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: red;
      font-size: 16px;
      text-align: center;
      max-width: 80%;
    }
    .psy-popup-product-title {
        font-size: 24px;
        font-weight: 700;
        line-height: normal;
        margin-bottom: 8px;
    }
    .psy-popup-subtitle {
        font-size: 16px;
        font-weight: 400;
        line-height: normal;
    }
    .psy-variant-group-farben  .psy-variant-group-values {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .product_title_mobile{
      display:none;
    }
    button.psy-custom3dmodle {
      position: absolute;
      bottom: 0;
      right: 0;
      z-index: 1;
      background:#000;
      color:#fff;
    }
    button.psy-custom3dmodle .thumbnail-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
        font-size: 11.5px;
        padding: 4px;
    }
    @media (min-width: 1024px) {
      .psy-variant-group-farben {
        position: absolute;
        bottom: 16px;
        left: 32px;
      }
    }
    @media (max-width:767px){
      .desk_componant{
        display:none;
      }
      .psy-popup-content{
        flex-direction: column;
      }
      .psy-popup-text, .psy-popup-image{
        max-width: 100%;
        padding-top: 0;
        flex-direction: column;
      }
      .psy-popup{
        top: unset;
        transform: unset;
        width: 100%;
        bottom: 0;
        left: 0;
        overflow: auto;
      }
      .product_title_mobile {
        display: block;
        padding: 40px 24px 24px;
        width: 100%;
        background: #fff;
      }
      .psy-variant-selector {
        margin-top: 0px;
      }
      .psy-variant-group-farben {
        background: #F7F7F7;
        margin: 0 -24px 24px;
        padding: 0 24px 24px;
      }
      .psy-variant-group-values {
        display: flex;
        flex-wrap: wrap;
        column-gap: 10px;
      }
    }
  </style>

  <button type="button" class="psy-custom3dmodle">
