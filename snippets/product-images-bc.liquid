<script type="application/json" id="variant-images-map-{{ product.id }}">
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": {{ variant.metafields.product.images.value | map: 'shopify_image_id' | json }}{% if forloop.last == false %},{% endif %}
    {% endfor %}
  }
</script>

{%- assign video_alt_text = product.metafields.custom.video_alt_text.value -%}

{%- unless product.empty? -%}
  <div
    class="product_media__original product__photos product__photos-{{ product.id }} product__photos--{{ thumbnail_position }}"
    data-product-images
  >
    {% render 'ed-video-popup', video_alt_text: video_alt_text %}
    {% render '3d-popup', blocks:blocks %}
    <div class="thumbnail_slider thumbnail_slider--desktop">
      <clever-slider
        id="ThumbnailSlider-{{ product.id }}"
        for="ProductPhotosSlider-{{ product.id }}"
        class="vertical only_large"
        options-large="loop: true, align:start, containScroll: keepSnaps, dragFree: true, axis: y"
        options-small="loop: true, align:start, containScroll: keepSnaps, dragFree: true"
      >
        <cs-track>
          <cs-slides class="items-5 gap">
            <!-- Slides go here -->
            {%- comment -%}Non-image media {%- endcomment -%}
            {%- for media in non_image_media -%}
              <cs-slide>
                {%- render 'media',
                  section_id: product.id,
                  media: media,
                  featured_media: featured_media,
                  loopIndex0: forloop.index0,
                  loopIndex: forloop.index,
                  product_zoom_enable: product_zoom_enable,
                  product_zoom_size: product_zoom_size,
                  product_image_size: product_image_size,
                  isModal: isModal,
                  video_looping: video_looping,
                  video_style: video_style,
                  sizes: sizes,
                  sizeVariable: sizeVariable,
                  fallback: fallback,
                  loading: loading,
                  mobile_layout: mobile_layout
                -%}
              </cs-slide>
            {%- endfor -%}

            {% for image_id in variant_images_ids %}
              {% assign matched_image = product.images | where: 'id', image_id | first %}
              {% if matched_image %}
                {% unless hide_images and forloop.index > 2 and forloop.index < 6 %}
                  <cs-slide
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    class="image-{{ matched_image.id }}"
                  >
                    {%- render 'image-element',
                      img: matched_image,
                      alt: matched_image.alt,
                      widths: '120, 360, 540, 720',
                      loading: loading
                    -%}
                  </cs-slide>
                {% endunless %}
              {% endif %}
            {% endfor %}

            
            {% comment %}
             {% for image in product.images %}
              {% if variant_images_ids contains image.id %}
                <cs-slide
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  class="image-{{ image.id }}"
                >
                  {%- render 'image-element',
                    img: image,
                    alt: image.alt,
                    widths: '120, 360, 540, 720',
                    loading: loading
                  -%}
                </cs-slide>
              {% endif %}
            {%- endfor -%} 
            {% endcomment %}
          </cs-slides>
        </cs-track>
      </clever-slider>
    </div>

    <div class="product__main-photos" data-aos data-product-single-media-group>
      {% if settings.tags_enable %}
        <style>
          .product__main-photos .grid-product__tags {
            left: 0;
            right: auto;
          }
        </style>
        {% render 'product_tags', product: product %}
      {% endif %}
      <div
        data-product-photos
        data-zoom="{{ product_zoom_enable }}"
        class="product-slideshow"
        id="ProductPhotos-{{ product.id }}"
      >
        <clever-slider
          id="ProductPhotosSlider-{{ product.id }}"
          options-large="loop:true,align:start"
          options-medium="loop:true,align:start"
          options-small="loop:true,align:start"
          pause-on-hover
        >
          <div class="slider_viewport">
            <cs-prev>
              <svg
                aria-hidden="true"
                focusable="false"
                role="presentation"
                class="icon icon--wide icon-chevron-down"
                viewBox="0 0 28 16"
              >
                <path d="m1.57 1.59 12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none"/>
              </svg>
            </cs-prev>
            <cs-track>
              <cs-slides class="items-1 sss">
                {%- comment -%}Non-image media {%- endcomment -%}
                {%- for media in non_image_media -%}
                  <cs-slide>
                    {%- render 'media',
                      section_id: product.id,
                      media: media,
                      featured_media: featured_media,
                      loopIndex0: forloop.index0,
                      loopIndex: forloop.index,
                      product_zoom_enable: product_zoom_enable,
                      product_zoom_size: product_zoom_size,
                      product_image_size: product_image_size,
                      isModal: isModal,
                      video_looping: video_looping,
                      video_style: video_style,
                      sizes: sizes,
                      sizeVariable: sizeVariable,
                      fallback: fallback,
                      loading: loading,
                      mobile_layout: mobile_layout
                    -%}
                  </cs-slide>
                {%- endfor -%}

                {% assign imagecounter = 0 %}
                {%- comment -%} Only show images that are assigned to the variant {%- endcomment -%}
                {% for image in product.images %}
                  {% if variant_images_ids contains image.id %}
                    {% assign imagecounter = imagecounter | plus: 1 %}
                    {% unless hide_images and imagecounter > 2 and imagecounter < 6 %}
                      {% comment %} onmousemove="zoom(event)" {% endcomment %}
                      <cs-slide
                        data-variant-id="{{product.selected_or_first_available_variant.id}}"
                        class="image-{{image.id}}"
                      >
                        {% if forloop.index == 1 %}
                          {%- assign loading = 'eager' -%}
                          {%- assign fetchpriority = 'high' -%}
                          {%- assign animation = 'none' -%}
                        {%- else -%}
                          {%- assign loading = 'lazy' -%}
                          {%- assign fetchpriority = 'auto' -%}
                          {%- assign animation = 'image-fade-in' -%}
                        {% endif %}
                        {% comment %}  Customize by Better Sell Online GmbH (BSO) - remove the hover effects on product image {% endcomment %}
                        {% comment %} 
                        <style>
                          
                          .image-{{ image.id }} {
                            background-image: url('{{ image | image_url }}');
                            background-position: 50% 50%;
                            cursor: zoom-in;
                          }
                        </style>
                        {% endcomment %}
                        {%- render 'image-element',
                          img: image,
                          alt: image.alt,
                          widths: '120, 360, 540, 720',
                          loading: loading,
                          animation: animation,
                          fetchpriority: fetchpriority
                        -%}
                      </cs-slide>
                    {% endunless %}
                  {% endif %}
                {%- endfor -%}
              </cs-slides>
            </cs-track>
            <cs-next>
              <svg
                aria-hidden="true"
                focusable="false"
                role="presentation"
                class="icon icon--wide icon-chevron-down"
                viewBox="0 0 28 16"
              >
                <path d="m1.57 1.59 12.76 12.77L27.1 1.59" stroke-width="2" stroke="#000" fill="none"/>
              </svg>
            </cs-next>
          </div>
        </clever-slider>
        <div
          class="product__photos product__photos-{{ product.id }} product__photos--{{ thumbnail_position }}"
          data-product-images
        >
          <div class="thumbnail_slider">
            <clever-slider
              id="ThumbnailSlider-mobile-{{ product.id }}"
              for="ProductPhotosSlider-{{ product.id }}"
              class="vertical only_small small_horizontal"
              options-large="loop: true, align:start,containScroll: keepSnaps, dragFree: true"
              options-small="loop: true, align:start,containScroll: keepSnaps, dragFree: true"
            >
              <cs-track>
                <cs-slides class="items-5 small_gap">
                  <!-- Slides go here -->
                  {%- comment -%}Non-image media {%- endcomment -%}
                  {%- for media in non_image_media -%}
                    <cs-slide>
                      {%- render 'media',
                        section_id: product.id,
                        media: media,
                        featured_media: featured_media,
                        loopIndex0: forloop.index0,
                        loopIndex: forloop.index,
                        product_zoom_enable: product_zoom_enable,
                        product_zoom_size: product_zoom_size,
                        product_image_size: product_image_size,
                        isModal: isModal,
                        video_looping: video_looping,
                        video_style: video_style,
                        sizes: sizes,
                        sizeVariable: sizeVariable,
                        fallback: fallback,
                        loading: loading,
                        mobile_layout: mobile_layout
                      -%}
                    </cs-slide>
                  {%- endfor -%}

                  {% assign imagecounter = 0 %}
                  {%- comment -%} Only show images that are assigned to the variant {%- endcomment -%}
                  {% for image in product.images %}
                    {% if variant_images_ids contains image.id %}
                      {% assign imagecounter = imagecounter | plus: 1 %}
                      {% unless hide_images and imagecounter > 2 and imagecounter < 6 %}
                        <cs-slide
                          data-variant-id="{{product.selected_or_first_available_variant.id}}"
                          class="image-{{image.id}}"
                        >
                          {% if forloop.index == 1 %}
                            {%- assign loading = 'eager' -%}
                            {%- assign fetchpriority = 'high' -%}
                            {%- assign animation = 'none' -%}
                          {%- else -%}
                            {%- assign loading = 'lazy' -%}
                            {%- assign fetchpriority = 'auto' -%}
                            {%- assign animation = 'image-fade-in' -%}
                          {% endif %}
                          {%- render 'image-element',
                            img: image,
                            alt: image.alt,
                            widths: '120, 360, 540, 720',
                            loading: loading,
                            animation: animation,
                            fetchpriority: fetchpriority
                          -%}
                        </cs-slide>
                      {% endunless %}
                    {% endif %}
                  {%- endfor -%}
                </cs-slides>
              </cs-track>
            </clever-slider>
          </div>
        </div>
      </div>
    </div>

    <div data-product-slide-container class="product__photos-{{ product.id }} hidden">
      {%- comment -%} Only show images that are assigned to the variant {%- endcomment -%}

      {% assign imagecounter = 0 %}
      {% for image in product.images %}
        {% if variant_images_ids contains image.id %}
          {% assign imagecounter = imagecounter | plus: 1 %}
          {% unless hide_images and imagecounter > 2 and imagecounter < 6 %}
            <cs-slide data-variant-id="{{ product.selected_or_first_available_variant.id }}" class="image-{{ image.id }}">
              {% comment %}  Customize by Better Sell Online GmbH (BSO) - remove the hover effects on product image {% endcomment %}
              {%- comment -%}
              <style>
                .image-{{image.id}} {
                  background-image: url('{{ image | image_url }}');
                  background-position: 50% 50%;
                }
              </style>
              {%- endcomment -%}
              {% if forloop.index == 1 %}
                {%- assign loading = 'eager' -%}
                {%- assign fetchpriority = 'high' -%}
                {%- assign animation = 'none' -%}
              {%- else -%}
                {%- assign loading = 'lazy' -%}
                {%- assign fetchpriority = 'auto' -%}
                {%- assign animation = 'image-fade-in' -%}
              {% endif %}
              {%- render 'image-element', img: image, alt: image.alt, widths: '120, 360, 540, 720', loading: loading, animation: animation,  fetchpriority: fetchpriority -%}
            </cs-slide>
            {% endunless %}
        {% endif %}
      {%- endfor -%}

      {%- comment -%} Load images that are not assigned to the variant, but hide them {%- endcomment -%}
      {% for map_entry in variant_images_map %}
        {% assign variant_id = map_entry | split: '_' | first %}
        {% assign image_id = map_entry | split: '_' | last %}
        {% unless variant_id == blank or image_id == blank %}
          {% for image in product.images %}
            {% if image_id contains image.id %}
              <cs-slide data-variant-id="{{variant_id}}" class="image-{{image.id}}">
                <style>
                  .image-{{image.id}} {
                    background-image: url('{{ image | image_url }}');
                    background-position: 50% 50%;
                  }
                </style>
                {%- render 'image-element',
                  img: image,
                  alt: image.alt,
                  widths: '120, 360, 540, 720',
                  loading: loading
                -%}
              </cs-slide>
              {% break %}
            {% endif %}
          {%- endfor -%}
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{%- else -%}
  {%- comment -%}
    Product empty
  {%- endcomment -%}
  <div class="product__photos product__photos-{{ product.id }}">
    <div class="product__main-photos" style="width: 100%">
      <div data-product-photos>
        <div class="product-main-slide" data-index="{{ forloop.index0 }}">
          <a href="#">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        </div>
      </div>
    </div>
  </div>
{%- endunless -%}

