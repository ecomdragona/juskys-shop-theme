<script>
  //product detail modal
  {% if context == 'main-product' %}
  window.onload = function(){
    prepareMainSlider();
    getModalCloser();
  }
  //modal controlls
  var modalIsOpen = false;
  function prepareMainSlider(){
    var mainSlider = document.querySelector('.product__main-photos cs-track');
    if (mainSlider){
      mainSlider.onclick = function(){
        openModal()
      }
    }
  }
  function getModalCloser(){
    var productImageModalCloser = document.querySelector('.product__photos__modal__closer');
    if(productImageModalCloser){
      productImageModalCloser.onclick = function(){
        closeModal();
      }
    }
  }
  //open modal
  function openModal(){
    if(!modalIsOpen){
      var modalContainer = document.querySelector('.product__photos__modal');
      var productImageSlider = document.querySelector('.product__photos');
      if(productImageSlider && modalContainer){
        modalContainer.classList.remove('hidden');
        modalContainer.appendChild(productImageSlider);
        modalIsOpen = true;

        //remove zoom when changing slide
        prevSlide = document.querySelector('.product__photos__modal cs-prev');
        nextSlide = document.querySelector('.product__photos__modal cs-next');
        if(prevSlide){
          prevSlide.onclick = function(){
            removeZoomClasses();
          }
        }
        if (nextSlide){
          nextSlide.onclick = function(){
            removeZoomClasses();
          }
        }
      }
    }
  }

  //close modal
  function closeModal(){
    if(modalIsOpen){
      var modalContainer = document.querySelector('.product__photos__modal');
      if(modalContainer){
        var productImageSlider = modalContainer.querySelector('.product__photos');
      }
      var productImageContainer = document.querySelector('.grid__item.medium-up--one-half.product-single__sticky')
      if(productImageSlider && productImageContainer){
        productImageContainer.prepend(productImageSlider);
        modalContainer.classList.add('hidden');
        modalIsOpen = false;
      }
    }
  }

  //zoom in and out of images using controlls
  //buttons
  var zoomInButton = document.querySelector('.product__photos__modal__zoom .zoom--in');
  var zoomOutButton = document.querySelector('.product__photos__modal__zoom .zoom--out');
  var zoomResetButton = document.querySelector('.product__photos__modal__zoom .zoom--reset');

  //zoom in
  if(zoomInButton){
    zoomInButton.onclick = function(){
      var currentSlideImage = document.querySelector('.product__photos__modal .product__main-photos .is-selected img');
      //add class with zoom x1.5
      if(currentSlideImage){
        // add: if classList doesent contain this class yet:
        if(!currentSlideImage.classList.contains('modal__image--zoomedx1')){
          currentSlideImage.classList.add('modal__image--zoomedx1');
          //add class with zoom x2 if zoom x1.5 class is already set:
        } else if(currentSlideImage.classList.contains('modal__image--zoomedx1') && !currentSlideImage.classList.contains('modal__image--zoomedx2')){
          currentSlideImage.classList.add('modal__image--zoomedx2');
        }
      }
    }
  }

  //zoom out
  if(zoomOutButton){
    zoomOutButton.onclick = function(){
      var currentSlideImage = document.querySelector('.product__photos__modal .product__main-photos .is-selected img');
      //remove class zoom2
      if(currentSlideImage){
        // add: if classList doesent contain this class yet:
        if(currentSlideImage.classList.contains('modal__image--zoomedx2')){
          currentSlideImage.classList.remove('modal__image--zoomedx2');
          //remove class with zoom x1 if zoom x2 class is not set:
        } else if(currentSlideImage.classList.contains('modal__image--zoomedx1') && !currentSlideImage.classList.contains('modal__image--zoomedx2')){
          currentSlideImage.classList.remove('modal__image--zoomedx1');
        }
      }
    }
  }

  //reset zoom (zoom out all the way)
  if(zoomResetButton){
    zoomResetButton.onclick = function(){
      removeZoomClasses();
    }
  }

  function removeZoomClasses(){
    var currentSlideImage = document.querySelector('.product__photos__modal .product__main-photos .is-selected img');
    if(currentSlideImage){
      if(currentSlideImage.classList.contains('modal__image--zoomedx1')){
        currentSlideImage.classList.remove('modal__image--zoomedx1');
      }
      if(currentSlideImage.classList.contains('modal__image--zoomedx2')){
        currentSlideImage.classList.remove('modal__image--zoomedx2');
      }
    }
  }


  {% endif %}
</script>

