{%- liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign first_3d_model = product.media | where: 'media_type', 'model' | first

  # Product images and thumbnails on the main product template should load early
  if context == 'main-product'
    assign loading = 'eager'
  endif

  assign variant_images_json = product.selected_or_first_available_variant.metafields.product.images.value
  assign variant_images_ids = null | sort
  for entry in variant_images_json
    assign image_id = entry.shopify_image_id | sort
    assign variant_images_ids = variant_images_ids | concat: image_id
  endfor

  assign variants_size = product.variants.size | minus: 1
  assign variant_images_map = '' | sort
  for temp_variant in product.variants
    if temp_variant.id != product.selected_or_first_available_variant.id
      for temp_variant_images_json in temp_variant.metafields.product.images.value
        unless hide_images and forloop.index > 2 and forloop.index < 6
          for temp_entry in temp_variant_images_json
              assign image_id = temp_entry | last
              assign image_map = temp_variant.id | append: '_' | append: image_id
              assign image_map = image_map | sort
              assign variant_images_map = variant_images_map | concat: image_map
          endfor
        endunless
      endfor
    endif
  endfor

  assign non_image_media = null | sort
  for media in product.media
    if media.media_type != 'image'
      assign temp = media | sort
      assign non_image_media = non_image_media | concat: temp
    endif
  endfor
-%}


