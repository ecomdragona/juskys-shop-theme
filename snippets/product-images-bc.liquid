  function updateVariantImages(event) {
    const variant_id = event.detail.variant_id;
    const product_image_slider = document.querySelectorAll('#ProductPhotosSlider-{{ product.id }}, #ThumbnailSlider-{{ product.id }}, #ThumbnailSlider-mobile-{{ product.id }}');
    const product_image_container = document.querySelector('.product__photos-{{ product.id }}[data-product-slide-container]');

    const variantImagesMap = JSON.parse(document.getElementById('variant-images-map-{{ product.id }}').textContent);
    const variantImagesIds = variantImagesMap[variant_id] || []; 

    if (product_image_slider.length > 0 && !!product_image_container) {
      product_image_slider.forEach((slider) => {
        // Remove current slides
        slider.querySelectorAll('cs-slide[data-variant-id]').forEach((slide) => {
          slider.querySelector('cs-slides').removeChild(slide);
        });

        // Add new slides
        variantImagesIds.forEach((image_id) => {
          const slideToAdd = product_image_container.querySelector(`cs-slide.image-${image_id}[data-variant-id="${variant_id}"]`);
          if (slideToAdd) {
            const temp_slide = slideToAdd.cloneNode(true);
            slider.querySelector('cs-slides').appendChild(temp_slide);
          }
        });

        if (typeof slider.rebuild === "function") {
          slider.rebuild();
        }
      });
    }

    // Append zoom function to main slider
    const main_slider = document.querySelector('#ProductPhotosSlider-{{ product.id }}');
    if (main_slider) {
      main_slider.querySelectorAll('cs-slide').forEach((slide) => {
        slide.addEventListener('mousemove', (event) => {
          zoom(event);
        });
        slide.style.cursor = "zoom-in";
      });
    }

    openModal();
    closeModal();
  }


  function zoom(e) {
    var zoomer = e.currentTarget; 
    let offsetX = 0;
    let offsetY = 0;
    if(e) {
      e.offsetX ? offsetX = e.offsetX : offsetX = e.touches[0].pageX
      e.offsetY ? offsetY = e.offsetY : offsetX = e.touches[0].pageX
      let x = 0;
      let y = 0;
      if (zoomer.offsetHeight > 0) {
        x = offsetX/zoomer.offsetWidth*100
      }
      if (zoomer.offsetWidth > 0) {
        y = offsetY/zoomer.offsetHeight*100
      }
      if(x && y > 0)
        zoomer.style.backgroundPosition = x + '% ' + y + '%';
    }
  }


  {% if template.suffix == "modal" or template.name == "product" %}
    document.dispatchEvent(new CustomEvent('update:variant:image', {
      detail: {
        variant_id: {{ product.selected_or_first_available_variant.id }}
      }
    }));
  {% endif %}
</script>
