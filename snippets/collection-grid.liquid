        </div>
          <div class="pro_grid_collection">
 <div class="page-width">
  <div class="grid grid--uniform{% if mobile_flush_grid %} small--grid--flush{% endif %}"{% unless enable_collection_count %} data-scroll-to{% endunless %}>
    {%- for item in items -%}
      {%- if item.object_type == 'product' -%}

        {% assign product_index = forloop.index %}
        {% for block in section.blocks %}
          {% if block.type == 'review_io_spotlight' %}
            {% if product_index == collection.metafields.custom.spotlight_review_position %}
              <div class="spotlight-review-io-mobile">{% render 'review_io_spotlight_mobile' %}</div>
            {% endif %}
          {% endif %}
        {% endfor %}

        {%- liquid
          if forloop.index <= 2
            assign loading = 'eager'
            assign fetchpriority = 'high'
          else
            assign loading = true
            assign fetchpriority = 'auto'
          endif
        -%}
        {%- assign widths = '360, 540, 720, 900' -%}

        {% assign variant_group = item.metafields.custom.variant_group_name %}
        {% assign varinat_enabled = item.metafields.custom.display_variant_as_products_on_cp %}
        {% assign has_option = false %}
          {% for option in item.options_with_values %}
            {% if option.name == variant_group %}
              {% assign has_option = true %}
            {% endif %}
          {% endfor %}
        {% assign variant_added = '' %}

        {% if varinat_enabled and has_option %}
            
            {% for option in item.options_with_values %}
              {% if option.name == variant_group %}
                {% for value in option.values %}
                  {% for var in item.variants %}
                      {% unless variant_added contains var.id %}
                          {% if var.title contains value %}
                              {%- render 'product-variant-item',
                                product: item,
                                variant_item:var
                                per_row: per_row,
                                quick_shop_enable: quick_shop_enable,
                                collection: collection,
                                widths: widths,
                                loading: loading,
                                variant_option_value:value
                              -%}
                              {% assign variant_added = variant_added | append:var.id | append:'__' %}
                              {% break %}
                          {% endif %}
                      {% endunless %}
                  {% endfor %}
                {% endfor %}
              {% endif %}
            {% endfor %}
            
          {% else %}
            {%- render 'product-grid-item',
              product: item,
              per_row: per_row,
              quick_shop_enable: quick_shop_enable,
              collection: collection,
              widths: widths,
              loading: loading
            -%}
          {% endif %}
      {%- else -%}
        {%- render 'search-grid-item',
          item: item,
          per_row: per_row
        %}
      {%- endif -%}
    {%- endfor -%}

    {% for block in section.blocks %}
      {% if block.type == 'spotlight_review_desktop' %}
          <div class="spotlight-review-io-desktop">{% render 'review_io_spotlight_desktop' %}</div>
      {% endif %}
    {% endfor %}
  </div>
  </div>
 </div>
</div>

{%- if enable_sidebar and filter_style != 'drawer' and collection.filters.size > 0 -%}
{% comment %}
  Sidebar enabled but not in drawer mode, only show filter button on mobile
{% endcomment %}
{% style %}
@media screen and (min-width: 769px) {
  .collection-filter__item--drawer {
    display: none;
  }
  .collection-filter__item--count {
    text-align: left;
  }
  html[dir="rtl"] .collection-filter__item--count {
    text-align: right;
  }
}
{% endstyle %}
{%- endif -%}

{%- if enable_sidebar == false or collection.filters.size == 0 -%}
{% comment %}
    Disable sidebar & filter features
{% endcomment %}
{% style %}
.collection-filter__item--drawer {
  display: none;
}
.collection-filter__item--count {
  text-align: left;
}
html[dir="rtl"] .collection-filter__item--count {
  text-align: right;
}
{% endstyle %}
{%- endif -%}

{%- unless enable_sort -%}
{% style %}
.collection-filter__sort-container {
  display: none;
}
{% endstyle %}
{%- endunless -%}