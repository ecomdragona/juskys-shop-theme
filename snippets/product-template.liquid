                      }
                        p.custom-message {
                          padding: 0 0 0 36px;
                          color: var(--color);
                        }
                      </style>
                      <div class="custom-div">
                        <div class="sales-point">
                          {% if state == 'in_stock' %}
                            <span>
                              <span class="icon icon--inventory"></span>
