                    <div
                      class="product-block product-block--delivery_time product-block--delivery_time-{{ block.id }}"
                      data-delivery-time
                      {{ block.shopify_attributes }}
                    >
                      {% liquid
                        assign deliverytimeMeta = current_variant.metafields.product.deliverytime.value | strip | replace: ' ', ''
                        assign deliverytimeMetaFirst = deliverytimeMeta | split: ',' | first | times: 1
                        assign inventory_policy = current_variant.inventory_policy
                        assign inventory_quantity = current_variant.inventory_quantity
                        assign state = 'sold_out'
                        assign color = 'red'
                        if current_variant.available
                          if deliverytimeMetaFirst < 7
                            assign state = 'in_stock'
                            assign color = '#92C020'
                          else
                            assign state = 'out_of_stock'
                            assign color = '#f4af29'
                          endif
                        endif
                      %}
                      <style>
                        /*Inventory indicator*/
                        @keyframes inventory-pulse {
                          0% {
                            opacity: 0.5;
                          }
                          100% {
                            transform: scale(2.5);
                            opacity: 0;
                          }
                        }
                        .product-block--delivery_time-{{ block.id }}{
                          display: flex;
                          align-items: center;
                          margin-bottom: 0px;
                        }
                        .product-block--delivery_time p{
                          color: var(--color);
                        }
                        .product-block--delivery_time .sales-point, .product-block--delivery_time p{
                          margin: 0;
                        }
                        .icon--inventory::before, .icon--inventory::after {
                          width: 9px;
                          height: 9px;
                          background: #92C020;
                          border-radius: 9px;
                          position: absolute;
                          left: 0;
                          top: 0;
                          content: '';
                          margin: 8px;
                        }
                        .icon--inventory::before {
                          animation: inventory-pulse 2s linear infinite;
                        }
                        .inventory--low .icon--inventory::before, .inventory--low .icon--inventory::after{
                          background: #F4AF29;
                        }
                        .inventory--empty .icon--inventory::before, .inventory--empty .icon--inventory::after{
                          background: red;
                        }
                        .sales-point {
                          display: block;
                          margin-bottom: 10px;
                        }
                        .sales-point:last-child{
                          margin-bottom: 0;
                        }
                        .sales-point-{{ block.id }} .icon{
                          position: relative;
                          width: 25px;
                          height: 25px;
                          margin-right: 0;
                        }
                        @media(max-width:767px){.sales-point-{{ block.id }} .icon{margin-right: 3px;}}
                      </style>
                      <div class="sales-point sales-point-{{ block.id }}">
                        {% if state == 'in_stock' %}
                          <span>
                            <span class="icon icon--inventory"></span>
                          </span>
                        {% elsif state == 'out_of_stock' %}
                          <span class="inventory--low">
                            <span class="icon icon--inventory"></span>
                          </span>
                        {% else %}
                          <span class="inventory--empty">
                            <span class="icon icon--inventory"></span>
                          </span>
                        {% endif %}
                      </div>
                      <p style="--color: {{color}};font-size: 11px; font-weight: 400; line-height: 20.4px; letter-spacing: -0.43px; text-align: left;">
                        {% if state == 'in_stock' %}
                          {% assign time = blank %}
                          {% if deliverytimeMeta == '2,3' %}
                            {% assign time = '1 - 3' %}
                          {% else %}
                            {% assign time = deliverytimeMeta | split: ',' | join: ' - ' %}
                          {% endif %}
                          {{ 'products.delivery_time.default' | t: time: time }}
                        {% elsif state == 'out_of_stock' %}
                          {% if deliverytimeMeta != blank %}
                            {% assign delivery_days = deliverytimeMeta | remove: ' ' | split: ',' | last | times: 1 %}
                            {% assign delivery_weeks = delivery_days | divided_by: 7.0 | ceil %}
                            {% assign delivery_days_first = deliverytimeMeta
                              | remove: ' '
                              | split: ','
                              | first
                              | times: 1
                            %}
                            {% assign delivery_weeks_first = delivery_days_first | divided_by: 7.0 | floor %}
                            {% assign week = 'products.delivery_time.week' | t %}
                            {% if delivery_weeks > 1 %}
                              {% assign week = 'products.delivery_time.weeks' | t %}
                            {% endif %}
                            {% assign day = 'products.delivery_time.day' | t %}
                            {% if delivery_days > 1 %}
                              {% assign day = 'products.delivery_time.days' | t %}
                            {% endif %}
                            {% if delivery_days_first > 6 %}
                              {% assign time = delivery_weeks | append: ' ' | append: week %}
                              {% if delivery_weeks != delivery_weeks_first %}
                                {% assign time = time | prepend: ' - ' | prepend: delivery_weeks_first %}
                              {% endif %}
                              {{ 'products.delivery_time.out_of_stock' | t: time: time }}
                            {% else %}
                              {% assign time = delivery_days | append: ' ' | append: day %}
                              {% if delivery_days != delivery_days_first %}
                                {% assign time = time | prepend: ' - ' | prepend: delivery_days_first %}
                              {% endif %}
                              {{ 'products.delivery_time.out_of_stock' | t: time: time }}
                            {% endif %}
                          {% endif %}
                        {% else %}
                          {{ 'products.product.sold_out' | t }}
                        {% endif %}
                      </p>
                    </div>
                    <div class="random_visit_text hide_random" product_id="{{ product.id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                      <path d="M14.7275 6.74588C15.2871 7.30548 15.2871 8.21278 14.7275 8.77238C14.1679 9.33199 13.2606 9.33199 12.701 8.77238C12.1413 8.21278 12.1413 7.30548 12.701 6.74588C13.2606 6.18627 14.1679 6.18627 14.7275 6.74588" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M10.0596 4.18776C10.9213 5.04943 10.9213 6.44648 10.0596 7.30817C9.19796 8.16984 7.8009 8.16984 6.93922 7.30817C6.07755 6.44649 6.07755 5.04944 6.93922 4.18776C7.8009 3.32609 9.19795 3.32609 10.0596 4.18776" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M4.29777 6.74588C4.85738 7.30548 4.85738 8.21278 4.29777 8.77238C3.73817 9.33199 2.83087 9.33199 2.27127 8.77238C1.71166 8.21278 1.71166 7.30548 2.27127 6.74588C2.83087 6.18627 3.73817 6.18627 4.29777 6.74588" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M16.2913 13.4583V12.682C16.2913 11.7038 15.4987 10.9111 14.5205 10.9111H13.9531" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M0.708008 13.4583V12.682C0.708008 11.7038 1.50063 10.9111 2.47884 10.9111H3.04622" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12.2811 13.4579V12.3239C12.2811 10.9547 11.1711 9.84473 9.80192 9.84473H7.19596C5.82676 9.84473 4.7168 10.9547 4.7168 12.3239V13.4579" stroke="#92C020" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {{ block.settings.random_visit | replace:"[random]",'<span class="random_visit_count"></span> ' }}
                    </div>
                    </div>
                  {%- when 'delivery_time' -%}
                      {% liquid
                        assign deliverytimeMeta = current_variant.metafields.product.deliverytime.value | strip | replace: ' ', ''
                        assign deliverytimeMetaFirst = deliverytimeMeta | split: ',' | first | times: 1
