<script>
  (() => {
      const soluteTracking = function (event) {
          const consent = event.detail; // Enthält die aktuellen Consent-Details
          if (consent.marketingAllowed) { // Prüft, ob Marketing-Cookies akzeptiert wurden
              try {
                  console.log("Marketing consent gegeben. Führe soluteLandingTracking aus...");
                  if (location.href.indexOf("soluteclid") < 0) return;
                  sessionStorage.setItem("soluteclid", (new Date()).getTime() + " " + location.href);
                  var url = "https://cmodul.solutenetwork.com/landing";
                  url += "?url=" + encodeURIComponent(location.href);
                  var req = new XMLHttpRequest();
                  req.open("GET", url);
                  req.send();
                  console.log("soluteLandingTracking erfolgreich durchgeführt.");
              } catch (e) {
                  console.log("sessionStorage not available!", e);
              }
          }
      };

      // Event-Listener für das visitorConsentCollected-Event hinzufügen
      document.addEventListener('visitorConsentCollected', soluteTracking);
  })();
</script>
