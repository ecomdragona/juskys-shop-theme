<div class="cart__item" data-key="{{ product.key }}">
  <div class="cart__image">
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback
        -%}
      </a>
    {% endif %}
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div>
              <span>{{ option.name }}:</span> {{ option.value }}
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            <div class="cart__item--properties">
              <span>{{ p.first }}:</span>
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
    <div class="cart__item-sub cart__item-price-position">
      <div>
        {% liquid
          assign deliverytimeMeta = product.variant.metafields.product.deliverytime.value | strip | replace: ' ', ''
          assign deliverytimeMetaFirst = deliverytimeMeta | split: ',' | first | times: 1
          assign inventory_policy = product.variant.inventory_policy
          assign inventory_quantity = product.variant.inventory_quantity
          assign state = 'sold_out'
          assign color = 'red'
          if product.variant.available
            if deliverytimeMetaFirst < 7
              assign state = 'in_stock'
              assign color = '#54c63a'
            else
              assign state = 'out_of_stock'
              assign color = '#f4af29'
            endif
          endif
        %}
        <div
          class="cart_item_test product-block product-block--delivery_time"
          data-delivery-time
        >
          <div class="custom-div">
            {% if product.product.handle == 'gutschein' %}
              <p style="--color: {{color}}">{{ settings.digital_product_text }}</p>
            {% else %}
              <p style="--color: {{color}}">
                {% if state == 'in_stock' %}
                  {% assign time = blank %}
                  {% if deliverytimeMeta == '2,3' %}
                    {% assign time = '1 - 3' %}
                    {% if localization.market.handle == 'frankreich' %}
                      {% assign time = '2 - 4' %}
                    {% endif %}
                  {% else %}
                    {% assign time = deliverytimeMeta | split: ',' | join: ' - ' %}
                    {% if localization.market.handle == 'frankreich' %}
                      {% assign parts = deliverytimeMeta | split: ',' %}
                      {% assign new_parts = '' %}
                      {% for p in parts %}
                        {% assign increased = p | plus: 1 %}
                        {% assign new_parts = new_parts | append: increased %}
                        {% unless forloop.last %}
                          {% assign new_parts = new_parts | append: ' - ' %}
                        {% endunless %}
                      {% endfor %}
                      {% assign time = new_parts %}
                    {% endif %}
                  {% endif %}
                  {{ 'products.delivery_time.cart' | t: time: time }}

                {% elsif state == 'out_of_stock' %}
                  {% if deliverytimeMeta != blank %}
                    {% assign delivery_days = deliverytimeMeta | remove: ' ' | split: ',' | last | times: 1 %}
                    {% assign delivery_weeks = delivery_days | divided_by: 7.0 | ceil %}
                    {% assign delivery_days_first = deliverytimeMeta | remove: ' ' | split: ',' | first | times: 1 %}
                    {% assign delivery_weeks_first = delivery_days_first | divided_by: 7.0 | floor %}
                    {% assign week = 'products.delivery_time.week' | t %}
                    {% if delivery_weeks > 1 %}
                      {% assign week = 'products.delivery_time.weeks' | t %}
                    {% endif %}
                    {% assign day = 'products.delivery_time.day' | t %}
                    {% if delivery_days > 1 %}
                      {% assign day = 'products.delivery_time.days' | t %}
                    {% endif %}
                    {% if delivery_days_first > 6 %}
                      {% assign time = delivery_weeks | append: ' ' | append: week %}
                      {% if delivery_weeks != delivery_weeks_first %}
                        {% assign time = time | prepend: ' - ' | prepend: delivery_weeks_first %}
                      {% endif %}
                      {{ 'products.delivery_time.out_of_stock' | t: time: time }}
                    {% else %}
                      {% assign time = delivery_days | append: ' ' | append: day %}
                      {% if delivery_days != delivery_days_first %}
                        {% assign time = time | prepend: ' - ' | prepend: delivery_days_first %}
                      {% endif %}
                      {{ 'products.delivery_time.out_of_stock' | t: time: time }}
                    {% endif %}
                  {% endif %}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </p>
            {% endif %}
          </div>

          {% if deliverytimeMeta == '2,3' and state == 'in_stock' %}
            {% if settings.custom_text != blank %}
              <p class="custom-message" style="--color: {{color}}">{{ settings.custom_text }}</p>
            {% endif %}
          {% endif %}
        </div>
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input
            type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}"
          >
          <button
            type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}"
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20">
              <path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/>
            </svg>
            <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button
            type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}"
          >
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20">
              <path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/>
            </svg>
            <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
          <button
            type="button"
            class="js-qty__adjust js-qty__adjust--remove"
          >
            <svg id="Objects" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 344.96 353.91">
              <defs>
                <style>
                  .cls-1-custom {
                    stroke: #4f5969;
                    stroke-miterlimit: 10;
                    stroke-width: 5px;
                  }
                </style>
              </defs>
              <path class="cls-1-custom" d="m292.01,97.32h-59.47v-34.86c0-3.08-2.39-5.13-5.13-5.13h-99.8c-3.08,0-5.13,2.39-5.13,5.13v34.86h-59.47c-3.08,0-5.13,2.39-5.13,5.13,0,3.08,2.39,5.13,5.13,5.13h34.86v183.87c0,3.08,2.39,5.13,5.13,5.13h149.35c2.73,0,4.79-2.05,5.13-4.78V107.58h34.52c2.73,0,5.13-2.39,5.13-5.13,0-3.08-2.39-5.13-5.13-5.13Zm-159.27-29.39h89.54v29.39h-89.54v-29.39Zm114.49,218.73H107.8V107.58h139.44v179.09Z"/>
              <path class="cls-1-custom" d="m142.66,137.31c-3.08,0-5.13,2.39-5.13,5.13v109.37c0,3.08,2.39,5.13,5.13,5.13s5.13-2.39,5.13-5.13v-109.37c0-3.08-2.05-5.13-5.13-5.13Z"/>
              <path class="cls-1-custom" d="m177.52,137.31c-3.08,0-5.13,2.39-5.13,5.13v109.37c0,3.08,2.39,5.13,5.13,5.13s5.13-2.39,5.13-5.13v-109.37c0-3.08-2.39-5.13-5.13-5.13Z"/>
              <path class="cls-1-custom" d="m212.38,137.31c-3.08,0-5.13,2.39-5.13,5.13v109.37c0,3.08,2.39,5.13,5.13,5.13s5.13-2.39,5.13-5.13v-109.37c0-3.08-2.05-5.13-5.13-5.13Z"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="cart__item-price-col text-right">
        {% if product.variant.compare_at_price > product.variant.price %}
          <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
          <small class="cart__price cart__price--strikethrough">
            {{ product.variant.compare_at_price | money }}
          </small>
          <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
          <span class="cart__price cart__discount">
            {{ product.variant.price | money }}
          </span>
        {% else %}
          <span class="cart__price">
            {{ product.variant.price | money }}
          </span>
        {% endif %}

        {%- if product.line_level_discount_allocations != blank -%}
          {%- for discount_allocation in product.line_level_discount_allocations -%}
            <small class="cart__discount">
              {{- discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})</small
            >
          {%- endfor -%}
        {%- endif -%}

        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement -%}
                {%- if product.unit_price_measurement.reference_value != 1 -%}
                  {{ product.unit_price_measurement.reference_value }}
                {%- endif -%}
                {{ product.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </span>
          {%- endcapture -%}

          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
