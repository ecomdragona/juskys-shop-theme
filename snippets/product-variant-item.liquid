{% assign sale_collection = collection.metafields.custom.sale_collection.value %}
{% assign show_variant = true %}
{% if sale_collection and variant_item.compare_at_price and variant_item.price >= variant_item.compare_at_price %}
  {% assign show_variant = false %}
{% endif %}
{% if show_variant %}
  {% comment %}
    Arguments
    - product: product object
    - [per_row]: number of items per row
    - [quick_shop_enable]: boolean
    - [collection]: collection object
    - widths: string
    - loading: string
    - fetchpriority: string
  {% endcomment %}

  {%- liquid
    unless per_row
      assign per_row = 4
    endunless

    capture gridView
      render 'products_per_row', products_per_row: per_row, style: 'fractions'
    endcapture

    # These assignments have no effect if a sizes parameter is passed in
    assign sizeVariable = gridView
    if fallback != blank
      assign fallback = fallback
    else
      assign fallback = 'variable'
    endif
    assign on_sale = false
    assign max_sale = 0
    for variant in product.variants
      if variant.compare_at_price > variant.price
        assign on_sale = true
        assign v_sale = variant.compare_at_price | minus: variant.price
        if max_sale < v_sale
          assign max_sale = v_sale
          assign sale_variant = variant
        endif
      endif
    endfor

    if fetchpriority == blank
      assign fetchpriority = 'auto'
    endif

    if widths == blank
      assign widths = '360, 540, 720, 900, 1080'
    endif
  -%}

  {% assign sale_variant = variant_item %}

  {% comment %}
              <!-- Sale tag -->
    {% unless product.tags contains "_label_sale" %}
      {% assign on_sale = false %}
      {% endunless %}
    <!-- Sale tag -->
  {% endcomment %}
  <div
    class="grid__item grid-product {{ gridView }} {% if quick_shop_enable %} grid-product__has-quick-shop{% endif %}"
    data-aos="row-of-{{ per_row }}"
    data-product-handle="{{ product.handle }}"
    data-product-id="{{ product.id }}"
  >
    <div class="grid-product__content">
      {% if settings.tags_enable %}
        {% if sale_variant != blank %}
          {% render 'product_tags', product: product, on_sale: on_sale, used_variant: sale_variant %}
        {% else %}
          {% render 'product_tags', product: product, on_sale: on_sale %}
        {% endif %}
      {% endif %}

      {%- liquid
        assign imageRatio = settings.product_grid_image_size
        assign fixed_aspect_ratio = false
        unless imageRatio == 'natural'
          assign fixed_aspect_ratio = true
        endunless

        if image_style == 'circle'
          assign fixed_aspect_ratio = true
          assign imageRatio = 'square'
        endif

        if sale_variant != blank
          assign preview_image = sale_variant.featured_media.preview_image
        else
          assign current_variant = variant_item
          assign preview_image = current_variant.featured_media.preview_image
        endif
      -%}

      <div class="grid__item-image-wrapper">
        <div class="grid-product__image-mask">
          {% comment %} {% render 'procentual-savings', product: product %} {% endcomment %}
          {%- if fixed_aspect_ratio -%}
            <div
              class="grid__image-ratio grid_item_first_img grid__image-ratio--{% if image_style == 'circle' %}square{% else %}{{ settings.product_grid_image_size }}{% endif %}"
            >
              {%- capture image_classes -%}
              {% unless settings.product_grid_image_fill %} grid__image-contain{% endunless %} image-style--{{ image_style }}
            {%- endcapture -%}
              {%- if preview_image != blank -%}
                {%- render 'image-element',
                  img: preview_image,
                  classes: image_classes,
                  sizes: sizes,
                  sizeVariable: sizeVariable,
                  fallback: fallback,
                  widths: widths,
                  loading: loading,
                  fetchpriority: fetchpriority
                -%}
              {%- else -%}
                {%- capture placeholder -%}product-{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                <div class="product-image--placeholder">{{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}</div>
              {%- endif -%}
            </div>
          {%- else -%}
            <div
              class="image-wrap"
              {% if preview_image != blank %}
                style="height: 0; padding-bottom: {{ 100 | divided_by: preview_image.aspect_ratio }}%;"
              {% endif %}
            >
              {%- if preview_image != blank -%}
                {%- capture image_classes -%}
                grid-product__image image-style--{{ image_style }}
              {%- endcapture -%}
                {%- render 'image-element',
                  img: preview_image,
                  classes: image_classes,
                  sizes: sizes,
                  sizeVariable: sizeVariable,
                  fallback: fallback,
                  widths: widths,
                  loading: loading,
                  fetchpriority: fetchpriority
                -%}
              {%- else -%}
                {%- capture placeholder -%}product-{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                <div class="product-image--placeholder">{{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if settings.product_hover_image and product.media.size > 1 -%}
            {% assign images_string = product.selected_or_first_available_variant.metafields.product.images | strip %}
            {% assign images_array = images_string | split: '},' %}
            {% if images_array.size > 1 %}
              {% assign second_item = images_array[1] | append: '}' %}

              {% assign id_start = second_item | split: '"shopify_image_id":' | last %}
              {% assign id_clean = id_start | remove: '}' | remove: ']' | strip %}

              {% assign second_image_id = id_clean | plus: 0 %}
              {% assign second_image_varinat = '' %}
            {% endif %}

            {%- for media in product.media offset: 1 limit: 1 -%}
              {%- assign second_image = media.preview_image -%}
            {%- endfor -%}
            {%- for image in product.images -%}
              {% if image.id == second_image_id %}
                {% assign second_image_varinat = image.src %}
              {% endif %}
            {%- endfor -%}
            {% if second_image_varinat != '' %}
              <div class="grid_item_second_img grid-product__secondary-image small--hide">
                {%- capture image_classes -%}
              image-style--{{ image_style }}
            {%- endcapture -%}
                {%- render 'image-element',
                  img: second_image_varinat,
                  classes: image_classes,
                  sizes: sizes,
                  sizeVariable: sizeVariable,
                  fallback: fallback,
                  widths: '360, 540, 720, 1000'
                -%}
              </div>
            {% else %}
              <div class="grid_item_second_img grid-product__secondary-image small--hide">
                {%- capture image_classes -%}
              image-style--{{ image_style }}
            {%- endcapture -%}
                {%- render 'image-element',
                  img: second_image,
                  classes: image_classes,
                  sizes: sizes,
                  sizeVariable: sizeVariable,
                  fallback: fallback,
                  widths: '360, 540, 720, 1000'
                -%}
              </div>
            {% endif %}
          {%- endif -%}
          {% comment %}
            {% if template.name == 'collection' %}
              <div class="pdp_slider_parent coll-{{ template.name }}">
                <div class="swiper product_item_image_slider">
                  <div class="swiper-wrapper">
                    {% for image in product.media limit: 10 %}
                      <div class="swiper-slide product_image_slide_item">
                        <a href="{{ product.url }}">
                          {%- capture image_classes -%}image-style--{{ image_style }}{%- endcapture -%}
                          {%- render 'image-element',
                            img: image,
                            classes: image_classes,
                            sizes: sizes,
                            sizeVariable: sizeVariable,
                            fallback: fallback,
                            loading: 'lazy',
                            widths: '360, 540, 720, 1000'
                          -%}
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                  <div class="card_slider_btn">
                    <button class="card_btn_prev" type="button" aria-label="Previous">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="15" viewBox="0 0 7 12" fill="none">
                        <path d="M6.35378 10.6462C6.40023 10.6927 6.43708 10.7479 6.46222 10.8086C6.48736 10.8692 6.50031 10.9343 6.50031 11C6.50031 11.0657 6.48736 11.1308 6.46222 11.1914C6.43708 11.2521 6.40023 11.3073 6.35378 11.3538C6.30732 11.4002 6.25217 11.4371 6.19148 11.4622C6.13078 11.4873 6.06572 11.5003 6.00003 11.5003C5.93433 11.5003 5.86928 11.4873 5.80858 11.4622C5.74788 11.4371 5.69273 11.4002 5.64628 11.3538L0.646277 6.35375C0.599789 6.30731 0.56291 6.25217 0.537747 6.19147C0.512585 6.13077 0.499634 6.06571 0.499634 6C0.499634 5.93429 0.512585 5.86923 0.537747 5.80853C0.56291 5.74783 0.599789 5.69269 0.646277 5.64625L5.64628 0.64625C5.7401 0.552429 5.86735 0.499722 6.00003 0.499722C6.13271 0.499722 6.25996 0.552429 6.35378 0.64625C6.4476 0.74007 6.50031 0.867318 6.50031 1C6.50031 1.13268 6.4476 1.25993 6.35378 1.35375L1.7069 6L6.35378 10.6462Z" fill="#000"/>
                      </svg>
                    </button>
                    <button class="card_btn_next" type="button" aria-label="Next">
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="15" viewBox="0 0 7 12" fill="none">
                        <path d="M6.35378 6.35375L1.35378 11.3538C1.30733 11.4002 1.25218 11.4371 1.19148 11.4622C1.13079 11.4873 1.06573 11.5003 1.00003 11.5003C0.934336 11.5003 0.869282 11.4873 0.808586 11.4622C0.747889 11.4371 0.692739 11.4002 0.646284 11.3538C0.599829 11.3073 0.562978 11.2521 0.537837 11.1914C0.512696 11.1308 0.499756 11.0657 0.499756 11C0.499756 10.9343 0.512696 10.8692 0.537837 10.8086C0.562978 10.7479 0.599829 10.6927 0.646284 10.6462L5.29316 6L0.646284 1.35375C0.552463 1.25993 0.499756 1.13268 0.499756 1C0.499756 0.867318 0.552463 0.74007 0.646284 0.64625C0.740104 0.552429 0.867352 0.499722 1.00003 0.499722C1.13272 0.499722 1.25996 0.552429 1.35378 0.64625L6.35378 5.64625C6.40027 5.69269 6.43715 5.74783 6.46231 5.80853C6.48748 5.86923 6.50043 5.93429 6.50043 6C6.50043 6.06571 6.48748 6.13077 6.46231 6.19147C6.43715 6.25217 6.40027 6.30731 6.35378 6.35375Z" fill="#000"/>
                      </svg>
                    </button>
                  </div>
                  <div class="swiper-scrollbar"></div>
                </div>
              </div>
            {% endif %}
          {% endcomment %}

          <div class="swatch-product__color-image"></div>

          {%- if settings.enable_swatches -%}
            {%- assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign option_name = option.name | downcase
                assign is_color = false
                if option_name contains swatch_trigger
                  assign is_color = true
                elsif swatch_trigger == 'color' and option_name contains 'colour'
                  assign is_color = true
                endif
              -%}
              {%- if is_color -%}
                {%- assign option_index = forloop.index0 -%}
                {%- for variant in product.variants -%}
                  {%- if variant.options[option_index] and variant.image -%}
                    <div
                      class="grid-product__color-image grid-product__color-image--{{ variant.id }} small--hide"
                      data-color-value="{{ variant.options[option_index] | handle }}"
                    ></div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if quick_shop_enable and type == blank -%}
            <button class="quick-product__btn quick-product__btn--not-ready js-modal-open-quick-modal-{{ product.id }} small--hide">
              {{ settings.quick_shop_text }}
            </button>
          {%- endif -%}
        </div>
        <a
          href="{{ product.url }}"
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          {% comment %}
            {% if current_variant.barcode %}
              data-trustami-prodid="{{ current_variant.barcode }}"
            {% endif %}
          {% endcomment %}
        ></a>
        <a
          href="{% if sale_variant != blank %} {{ sale_variant.url }} {% else %} {{ product.url }} {% endif %}"
          class="grid-product__link"
        >
          <div class="grid-product__meta">

            {%if template.name == 'collection' %}
              <div
                class="grid-product__price version-3-price-show"
                data-com="{{ product.compare_at_price | money }}"
                data-price="{{ product.price | money }}"
              >
                {%- if on_sale and sale_variant.compare_at_price > sale_variant.price -%}
                  <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
                  <span class="grid-product__price--original">{{ sale_variant.compare_at_price | money }}</span>
                  <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
                  <span class="grid-product__price--price">
                    {{ sale_variant.price | money }}
                  </span>
                  {% comment %}
                  <span class="grid-product__price--sale-badge">
                    -{{ sale_variant.compare_at_price | minus: sale_variant.price | times: 100.0 | divided_by: sale_variant.compare_at_price | round }}%
                  </span>
                  {% endcomment %}
                {% else %}
                  <span class="grid-product__price--price">
                    {% comment %}
                      {%- if product.price_varies -%}
                        {%- assign price = product.price_min | money -%}
                        {{ 'products.general.from_text_html' | t: price: price }}
                      {%- else -%}
                      {%- endif -%}
                    {% endcomment %}
                    {{ sale_variant.price | money }}
                  </span>
                {%- endif -%}
                {%- if on_sale -%}
                  {%- if settings.product_save_amount -%}
                    {%- if settings.product_save_type == 'dollar' -%}
                      {%- capture saved_amount -%}{{ sale_variant.compare_at_price | minus: sale_variant.price | money }}{%- endcapture -%}
                    {%- else -%}
                      {%- capture saved_amount -%}{{ sale_variant.compare_at_price | minus: sale_variant.price | times: 100.0 | divided_by: sale_variant.compare_at_price | round }}%{%- endcapture -%}
                    {%- endif -%}
                    <span class="grid-product__price--savings">
                      {{ 'products.general.save_html' | t: saved_amount: saved_amount }}
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- assign product_variant = product.selected_or_first_available_variant -%}
                {%- if product_variant.unit_price_measurement -%}
                  <div class="product__unit-price">
                    {%- capture unit_price_base_unit -%}
                    {%- if product_variant.unit_price_measurement -%}
                      {%- if product_variant.unit_price_measurement.reference_value != 1 -%}
                        {{ product_variant.unit_price_measurement.reference_value }}
                      {%- endif -%}
                      {{ product_variant.unit_price_measurement.reference_unit }}
                    {%- endif -%}
                  {%- endcapture -%}

                    {{ product_variant.unit_price | money }}/{{ unit_price_base_unit }}
                  </div>
                {%- endif -%}
              </div>
            {% endif %} 
            
            <div class="outer-grid-product__title">
              <div class="grid-product__title   grid-product__title--{{ settings.type_product_style }}">
                <div class="inner-text">{{ product.title }} - {{ variant_option_value }}</div>
                <div class="productsubtitle">{{ product.metafields.product.subtitle }}</div>
                <div
                  class="ruk_rating_snippet"
                  data-sku="{{ product.handle }};{{ product.variants | map: 'sku' | join: ';' }};{{ product.variants | map: 'id' | join: ';' }}"
                ></div>
              </div>
            </div>
            {%- if settings.vendor_enable -%}
              <div class="grid-product__vendor">{{ product.vendor }}</div>
            {%- endif -%}

            <div
              class="grid-product__price version-3-price-hide"
              data-com="{{ product.compare_at_price | money }}"
              data-price="{{ product.price | money }}"
            >
              {%- if on_sale and sale_variant.compare_at_price > sale_variant.price -%}
                <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
                <span class="grid-product__price--original">{{ sale_variant.compare_at_price | money }}</span>
                <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
                <span class="grid-product__price--price">
                  {{ sale_variant.price | money }}
                </span>
              {% else %}
                <span class="grid-product__price--price">
                  {% comment %}
                    {%- if product.price_varies -%}
                      {%- assign price = product.price_min | money -%}
                      {{ 'products.general.from_text_html' | t: price: price }}
                    {%- else -%}
                    {%- endif -%}
                  {% endcomment %}
                  {{ sale_variant.price | money }}
                </span>
              {%- endif -%}
              {%- if on_sale -%}
                {%- if settings.product_save_amount -%}
                  {%- if settings.product_save_type == 'dollar' -%}
                    {%- capture saved_amount -%}{{ sale_variant.compare_at_price | minus: sale_variant.price | money }}{%- endcapture -%}
                  {%- else -%}
                    {%- capture saved_amount -%}{{ sale_variant.compare_at_price | minus: sale_variant.price | times: 100.0 | divided_by: sale_variant.compare_at_price | round }}%{%- endcapture -%}
                  {%- endif -%}
                  <span class="grid-product__price--savings">
                    {{ 'products.general.save_html' | t: saved_amount: saved_amount }}
                  </span>
                {%- endif -%}
              {%- endif -%}

              {%- assign product_variant = product.selected_or_first_available_variant -%}
              {%- if product_variant.unit_price_measurement -%}
                <div class="product__unit-price">
                  {%- capture unit_price_base_unit -%}
                  {%- if product_variant.unit_price_measurement -%}
                    {%- if product_variant.unit_price_measurement.reference_value != 1 -%}
                      {{ product_variant.unit_price_measurement.reference_value }}
                    {%- endif -%}
                    {{ product_variant.unit_price_measurement.reference_unit }}
                  {%- endif -%}
                {%- endcapture -%}

                  {{ product_variant.unit_price | money }}/{{ unit_price_base_unit }}
                </div>
              {%- endif -%}
            </div>

            {%- if settings.enable_swatches and type == 'horizontal' -%}
              {%- liquid
                assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase
                assign swatch_file_extension = 'png'
                assign color_count = 0
              -%}

              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_name = option.name | downcase
                  assign is_color = false
                  if option_name contains swatch_trigger
                    assign is_color = true
                  elsif swatch_trigger == 'color' and option_name contains 'colour'
                    assign is_color = true
                  endif
                -%}
                {%- if is_color -%}
                  {%- assign option_index = forloop.index0 -%}
                  {%- assign values = '' -%}
                  <div class="grid-product__colors grid-product__colors--{{ product.id }}">
                    {%- for variant in product.variants -%}
                      {%- assign value = variant.options[option_index] %}
                      {% if variant.title contains variant_option_value %}
                        {%- liquid
                          assign values = values | join: ',' | append: ',' | append: value | split: ','

                          assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
                          assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                          assign color_swatch_fallback = value | split: ' ' | last | handle
                          assign color_count = color_count | plus: 1
                        -%}

                        <span
                          class="color-swatch color-swatch--small color-swatch--{{ value | handle }}{% if variant.image %} color-swatch--with-image{% endif %}"
                          {% if variant.image %}
                            data-variant-id="{{ variant.id }}"
                            data-variant-image="{{ variant.image | img_url: '400x' }}"
                          {% endif %}
                          aria-label="{{ product.title }} - {{ value }}"
                          style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
                        >
                          <span class="visually-hidden">{{ value }}</span>
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if color_count < 2 -%}
                    {%- style -%}
                      .grid-product__colors--{{ product.id }} {
                        display: none;
                      }
                    {%- endstyle -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <div class="elsklip__block_original">
              {% render 'elsklip_collection_block', product: product, short: true %}
            </div>

            {%- if settings.enable_product_reviews and type == 'horizontal' -%}
              <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
            {%- endif -%}
          </div>
        </a>
      </div>
      {% comment %} product based {% endcomment %}
 
        
    </div>

    {%- if settings.enable_swatches and type == blank -%}
      {%- liquid
        assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase
        assign swatch_file_extension = 'png'
        assign color_count = 0
      -%}

      {%- for option in product.options_with_values -%}
        {%- liquid
          assign option_name = option.name | downcase
          assign is_color = false
          if option_name contains swatch_trigger
            assign is_color = true
          elsif swatch_trigger == 'color' and option_name contains 'colour'
            assign is_color = true
          endif
        -%}
        {%- if is_color -%}
          {%- assign option_index = forloop.index0 -%}
          {%- assign unique_colors = '' | split: ',' -%}
          <div class="grid-product__colors grid-product__colors--{{ product.id }}">
            {%- for value in option.values -%}
              {%- unless unique_colors contains value -%}
                {%- liquid
                  assign unique_colors = unique_colors | push: value

                  assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
                  assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
                  assign color_swatch_fallback = value | split: ' ' | last | handle
                  assign color_count = color_count | plus: 1

                  comment
                    Find the matching variant for this specific color value
                    First try to find an available variant
                  endcomment
                  assign variant_for_swatch = null
                  for variant in product.variants
                    if variant.options[option_index] == value and variant.available
                      assign variant_for_swatch = variant
                      break
                    endif
                  endfor

                  comment
                    If no available variant found, use the first matching variant
                  endcomment
                  unless variant_for_swatch
                    for variant in product.variants
                      if variant.options[option_index] == value
                        assign variant_for_swatch = variant
                        break
                      endif
                    endfor
                  endunless
                -%}

                <a
                  href="{{ variant_for_swatch.url }}"
                  class="color-swatch color-swatch-link color-swatch--small color-swatch--{{ value | handle }}{% if variant_for_swatch.image %} color-swatch--with-image{% endif %}"
                  {% if variant_for_swatch.image %}
                    data-variant-id="{{ variant_for_swatch.id }}"
                    data-variant-image="{{ variant_for_swatch.image | img_url: '400x' }}"
                  {% endif %}
                  aria-label="{{ product.title }} - {{ value }}"
                  style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %} background-image: url({{ color_image }});{% endif %}"
                >
                  <span class="visually-hidden">{{ value }}</span>
                </a>

                <span
                  href="{{ variant_for_swatch.url }}"
                  class="color-swatch-btn 
                  {%if sale_variant.title contains value %}active_swatch_btn{% endif %} 
                  color-swatch color-swatch--small color-swatch--{{ value | handle }}{% if variant_for_swatch.image %} color-swatch--with-image{% endif %}"
                  data-variant-id="{{ variant_for_swatch.id }}"
                  {% if variant_for_swatch.image %}
                    data-variant-image="{{ variant_for_swatch.image | img_url: '400x' }}"
                  {% else %}
                    data-variant-image="{{ product.featured_image | img_url: '400x' }}"
                  {% endif %}
                  data-variant-link="{{ variant_for_swatch.url }}"
                  aria-label="{{ product.title }} - {{ value }}"
                  style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %} background-image: url({{ color_image }});{% endif %}"
                >
                  <span class="visually-hidden">{{ value }}</span>
                </span>
              {%- endunless -%}
            {%- endfor -%}
          </div>

          {%- if color_count < 2 -%}
            {%- style -%}
              .grid-product__colors--{{ product.id }} {
                display: none;
              }
            {%- endstyle -%}
          {%- endif -%}
        {%- elsif color_count == 0 -%}
          <div class="small--hide" style="margin: 3px 0 5px 0; min-height:23px;"></div>
          <div class="medium-up--hide" style="margin: 3px 0 5px 0; min-height:19px;"></div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {% if settings.enable_other_variants and product.has_only_default_variant == false %}
      {%- assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase -%}
      {% assign has_other_variants = false %}
      {%- for option in product.options_with_values -%}
        {% assign option_downcase = option.name | downcase %}
        {% if option_downcase != swatch_trigger %}
          {% assign has_other_variants = true %}
           {% for value in option.values %}
           {% assign value_length = forloop.length %}
          {% endfor %}
        {% endif %}
      {%- endfor -%}
      {% if has_other_variants %}
        <div class="grid-product__more-variants-container">
          <a
            href="{{product.selected_or_first_available_variant.url}}"
            class="grid-product__link grid-product__more-variants"
          >
            <svg xmlns="http://www.w3.org/2000/svg" id="Objects" viewBox="0 0 344.96 353.91" width="15px">
              <circle class="cls-2" style="fill: none;
                stroke: #1d1d1b;
                stroke-miterlimit: 10;
                stroke-width: 14px;" cx="172.48" cy="178.3" r="124.17"/>
              <line class="cls-1" style="stroke-linecap: round;fill: none;
                stroke: #1d1d1b;
                stroke-miterlimit: 10;
                stroke-width: 14px;" x1="172.48" y1="107.51" x2="172.48" y2="246.4"/>
              <line class="cls-1" style="stroke-linecap: round;fill: none;
                stroke: #1d1d1b;
                stroke-miterlimit: 10;
                stroke-width: 14px;" x1="103.03" y1="176.96" x2="241.92" y2="176.96"/>
            </svg>
            {{ 'products.general.more_variants_available' | t -}}
          </a>
          <a
            href="{{product.selected_or_first_available_variant.url}}"
            class="grid-product__link grid-product__more-variants var_b" style="display:none;"
          >
           (+{{value_length }} {{ 'products.general.more_variants_available' | t -}})
          </a>
          
        </div>
      {% endif %}
    {% endif %}


{% comment %} variant based {% endcomment %}
  {% assign raw_delivery_time = product.selected_or_first_available_variant.metafields.product.deliverytime | strip %}
  
{% assign delivery_time = raw_delivery_time | plus: 0 %}


{% if delivery_time <= 3 and delivery_time != 0 %}
  <p class="delivery-info variant" data-ab-test="lieferzeit-variante-a">{{ settings.ship_text }}</p>
{% endif %}
    <div class="elsklip__block_versionB">
      {% render 'elsklip_collection_block', product: product, short: true %}
    </div>

    {%- if settings.enable_product_reviews and type == blank -%}
      <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
    {%- endif -%}

    {%- if quick_shop_enable and type == blank -%}
      {%- render 'quick-shop-modal', product: product -%}
    {%- endif -%}
    {% render 'product-form', product: product, current_variant: current_variant %}
  </div>
{% endif %}
