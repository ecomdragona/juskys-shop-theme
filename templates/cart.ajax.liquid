{% comment %}
  JS-load cart markup without bloat of a full layout.

  This is used in both the cart drawer and cart page.
  When a quantity is changed, this file is scraped and data-products
    is fully replaced to account for possible cart discounts changing

  The cart-wide discount div also replaces what is originally in the cart
    as it can change anytime a cart-item changes
{% endcomment %}
{% layout none %}

{% assign total_compare_price = 0 %}
{% assign total_original_price = 0 %}
{%- for item in cart.items -%}
  {% assign item_compare_price = item.variant.compare_at_price | default: item.variant.price %}
  {% assign item_total_compare = item_compare_price | times: item.quantity %}
  {% assign item_total_original = item.variant.price | times: item.quantity %}
  {% assign total_compare_price = total_compare_price | plus: item_total_compare %}
  {% assign total_original_price = total_original_price | plus: item_total_original %}
{% endfor %}
{% if total_compare_price > total_original_price or cart.discounts > 0 %}
  {% assign cart_total_disc = total_compare_price | minus: total_original_price | plus:cart.total_discount | money %}
{% endif %}

<div class="cart__items"
  data-count="{{ cart.item_count }}"
  data-cart-subtotal="{{ cart.total_price }}" data-cart-discount="{{ cart_total_disc }}">
  {% for item in cart.items %}
    {%- render 'cart-item', product: item, sizes: '100px', -%}
  {% endfor %}
  {% render 'cart-drawer-upsell' %}
</div>
<div class="cart__discounts cart__item-sub cart__item-row{% if cart.cart_level_discount_applications == blank %} hide{% endif %}">
  <div>Rabatt</div>
  <div>
    {% for cart_discount in cart.cart_level_discount_applications %}
      <div class="cart__discount">
        {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
      </div>
    {% endfor %}
  </div>
</div>
