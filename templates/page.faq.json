        "template--20174419296559__bf507c17-ecc5-4ed4-addd-c40f2ab9e09f-text-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>Hier findest du Antworten auf die Fragen, die uns häufig gestellt werden. Sollte deine Frage nicht dabei sein, sende uns gerne eine <a href=\"https://juskysshop.myshopify.com/pages/contact\" title=\"https://juskysshop.myshopify.com/pages/contact\">Nachricht</a> oder ruf uns an. Unser Kundenservice hilft dir gerne weiter.</p><p><a href=\"tel:+495062965660\">+49 (0)5062 - 965660</a></p><p>Mo - Fr: 08:00 - 20:00 Uhr<br/>Sa: 09:00 - 18:00 Uhr</p>"
          }
        }
      },
