    "032b6fe6-532a-460e-a7a6-36a7a7165946": {
      "type": "advanced-content",
      "blocks": {
        "template--21068250153263__032b6fe6-532a-460e-a7a6-36a7a7165946-liquid-1": {
          "type": "liquid",
          "settings": {
            "code": "<h2>Wie gestalte ich eine gemütliche Sitzecke?</h2><p>\nEin wichtiger Platz im Garten, auf der Terrasse oder dem Balkon ist der sogenannte Hyggekrog. Die Dänen verstehen darunter eine persönliche Ecke, die zur Entspannung und Entschleunigung dient. An diesem Rückzugsort fühlt man sich geborgen. Du fragst dich, wie du eine gemütliche Sitzecke im Garten errichtest? Mit diesen Schritten wird das gelingen. So erfährst du, was neben Kissen, Decken und Deko dazugehört.</p>",
            "width": "50%",
            "alignment": "center"
          }
        },
        "template--21068250153263__032b6fe6-532a-460e-a7a6-36a7a7165946-image-1": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/gemuetliche-sitzecke-im-garten.jpg",
            "link": "",
            "width": "50%",
            "alignment": "center"
          }
        }
      },
      "block_order": [
        "template--21068250153263__032b6fe6-532a-460e-a7a6-36a7a7165946-liquid-1",
        "template--21068250153263__032b6fe6-532a-460e-a7a6-36a7a7165946-image-1"
      ],
      "settings": {
        "full_width": false,
