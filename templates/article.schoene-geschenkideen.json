    "42635bf3-7082-4089-82bd-bcac82629d12": {
      "type": "advanced-content",
      "blocks": {
        "template--21068250153263__42635bf3-7082-4089-82bd-bcac82629d12-image-1": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/gemuetlich-platznehmen.jpg",
