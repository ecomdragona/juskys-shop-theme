{{ 'product-tabs.css' | asset_url | stylesheet_tag }}

<div class="product-tabs-main">
  <div class="page-width">
    <div class="variant-tabs-nav">
      <ul>
        {% assign tab_content = '' %}
        {% for block in section.blocks %}
          <li
            {% if forloop.index == 1 %}
              class="active"
            {% endif %}
          >
            <a href="#tab-{{ forloop.index }}">{{ block.settings.tab_heading }}</a>
          </li>
          {% capture this_tab_content %}
            <div id="tab-{{ forloop.index }}" class="tab_content_main" {% if forloop.index != 1 %} style="display:none" {% endif %}>
              {% if block.type == 'tab' %}
                {% if block.settings.content != blank %}
                  {{ block.settings.content }}
                {% endif %}
              {% elsif block.type == 'custom_tab' %}
              {% if block.settings.variant_metafield != blank %}
                  {% assign metafields = block.settings.variant_metafield | split: '.' %}
                  {% assign namespace = metafields[0] %}
                  {% assign key = metafields[1] %}
                  {% assign variant = product.selected_or_first_available_variant %}
                  {% capture meta_content %}
                    {{ variant.metafields[namespace][key] | metafield_tag }}
                  {% endcapture %}
                          {{ meta_content | remove_first: '<p>' | remove_first: '</p>' }}
                {% endif %}
              {% endif %}
              <div class="tab_overlay_viewmore">
                <span class="tab_viewmore_btn">Lese mehr</span>
                <span class="tab_viewless_btn">Weniger anzeigen</span>
              </div>
            </div>
          {% endcapture %}
          {% assign tab_content = tab_content | append: this_tab_content %}
        {% endfor %}
      </ul>
    </div>

    <div class="tabs-content">
      {{ tab_content }}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.variant-tabs-nav a');

    tabs.forEach((tab) => {
      tab.addEventListener('click', function (event) {
        event.preventDefault();

        document.querySelectorAll('.variant-tabs-nav li').forEach((item) => {
          item.classList.remove('active');
        });

        this.parentElement.classList.add('active');

        document.querySelectorAll('.tabs-content .tab_content_main').forEach((content) => {
          content.style.display = 'none';
        });

        const currentTab = document.querySelector(this.getAttribute('href'));
        if (currentTab) {
          currentTab.style.display = 'block';

          const rect = currentTab.getBoundingClientRect();

          const viewMoreBtn = currentTab.querySelector('.tab_overlay_viewmore');

          if (viewMoreBtn) {
            if (rect.height > 700) {
              viewMoreBtn.style.display = 'flex';
            } else {
              viewMoreBtn.style.display = 'none';
            }
          }
        }
      });
    });

    const tabs_viewmore = document.querySelectorAll('.tab_viewmore_btn');
    const tabs_viewless = document.querySelectorAll('.tab_viewless_btn');

    tabs_viewmore.forEach((item) => {
      item.addEventListener('click', function () {
        const tabContent = this.closest('.tab_content_main');
        if (tabContent) {
          tabContent.classList.toggle('full_view');
        }
      });
    });
    tabs_viewless.forEach((item) => {
      item.addEventListener('click', function () {
        const tabContent = this.closest('.tab_content_main');
        if (tabContent) {
          tabContent.classList.toggle('full_view');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Tabs",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_heading",
          "label": "Tab Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Use collapsible tabs for more detailed information that will help customers make a purchasing decision.</p><p>Ex: Shipping and return policies, size guides, and other common questions.</p>"
        }
      ]
    },
    {
      "type": "custom_tab",
      "name": "Custom Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_heading",
          "label": "Tab Heading"
        },
        {
          "type": "text",
          "id": "variant_metafield",
          "label": "Variant Metafield",
          "info": "Please, insert it as namespace.key",
          "default": "product.details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}
