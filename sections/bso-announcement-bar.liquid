{% liquid
  assign text_color_alpha = section.settings.text_color | color_extract: 'alpha'
  assign background_color_alpha = section.settings.background_color | color_extract: 'alpha'
  assign background_brightness = section.settings.background_color | brightness_difference: '#000'
  if background_brightness < 125
    assign accent_color = '#FFF'
  else
    assign accent_color = '#000'
  endif
%}

<style>
#shopify-section-{{section.id}} {
  {% if background_color_alpha != 0 %}
   background-color: {{ section.settings.background_color }};
  {% else %}
    background-color: var(--colorBody);
  {% endif %}
}

#shopify-section-{{section.id}} .countdown-arrow {
  position: absolute;
  display: block;
  width: 25px;
  height: 25px;
  margin-left: -1.875rem;
  text-align: center;
  padding-top: 0.125rem;
  transition: all .25s linear;
  cursor: pointer;
  top: 5%;
  right: 1px;
  z-index: 30;
}

#shopify-section-{{section.id}} .countdown-arrow svg {
  height: 50%;
  width: 50%;
}

#shopify-section-{{section.id}} .countdown-arrow svg path{
  fill: #6d7175;
}

#shopify-section-{{section.id}} .countdown-arrow-wrapper{
  position: relative;
} 

#shopify-section-{{section.id}} .countdown-arrow i{
  font-size: .75rem;
  transition: all .25s linear;
  display: inline-block;
}

#shopify-section-{{section.id}} .countdown__content {
  height: 100%;
  padding: 15px 15px 10px;
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  justify-content: normal;
}

#shopify-section-{{section.id}} .countdown__richtext p:nth-child(1),
#shopify-section-{{section.id}} .countdown__heading p.aux_class:nth-child(1) {
  display: none;
}

#shopify-section-{{section.id}} .countdown__richtext p:nth-child(2),
#shopify-section-{{section.id}} .countdown__heading p.aux_class:nth-child(2) {
  display: block;
}

#shopify-section-{{section.id}}  .countdown__block {
  margin: 0 auto;
}

#shopify-section-{{section.id}} .countdown__block.countdown__block--content {
  flex: 1 1 100%;
  max-width: 100%;
  margin-bottom: 10px;
}

#shopify-section-{{section.id}} .countdown__text-wrapper--content-alignment-left,
#shopify-section-{{section.id}} .countdown__text-wrapper--content-alignment-right {
  text-align: center;
}

#shopify-section-{{section.id}} .countdown__block.countdown__block--timer {
  flex: 1 1 60%;
  max-width: 60%;
  display: flex;
  justify-content: center;
}

#shopify-section-{{section.id}} .countdown__block.countdown__block--button {
  flex: 1 1 100%;
  display: flex;
  margin-top: 10px;
}

#shopify-section-{{section.id}} .countdown__block.countdown__block--button.center {
  justify-content: center;
}

#shopify-section-{{section.id}} .countdown__block.countdown__block--button .btn {
  padding: 6px 7px;
  line-height: 1.5;
  font-size: 11px;
  letter-spacing: normal;
  text-transform: none;
  border-radius: 4px;
  display: block;
  min-width: auto;
}

#shopify-section-{{section.id}} .countdown__block--content .countdown__heading .aux_class {
  font-size: 14px;
  color: #202223;
  margin: 0;
  padding: 0;
  line-height: 1.2;
  letter-spacing: normal;
  text-transform: none;
  font-weight: 700;
}

#shopify-section-{{section.id}} .countdown__block--content .countdown__richtext p {
  font-size: 12px;
  color: #202223;
  line-height: 1.2;
  letter-spacing: normal;
  padding: 0;
  margin: 0;
}

#shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block {
  padding: 0;
  border-right: none;
}

#shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block.timer {
  min-width: 30px;
  max-width: 30px;
}

#shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block.separator {
  font-weight: 800;
}

#shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block p {
  font-size: 16px;
  font-weight: 600;
  color: #202223;
}

#shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block span {
  font-size: 8px;
  color: #000000;
  text-transform: capitalize;
  letter-spacing: normal;
  margin-top: -12px;
}

@media only screen and (min-width:375px){
  #shopify-section-{{section.id}} .countdown__content {
    justify-content: center;
  }

  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--content,
  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--timer,
  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--button  {
    flex: 1 1 50%;
    max-width: 50%;
    justify-content: center;
  }

  #shopify-section-{{section.id}} .single-block .countdown__block.countdown__block--content,
  #shopify-section-{{section.id}} .single-block .countdown__block.countdown__block--timer {
    flex: 1 1 100%;
    max-width: 100%;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--content {
    flex: 1 1 40%;
    max-width: 40%;
    margin: 0;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--timer {
    flex: 1 1 40%;
    max-width: 40%;
    margin: 0;
    justify-content: start;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--button {
    flex: 1 1 auto;
    max-width: fit-content;
    margin-top: 5px;
  }

  #shopify-section-{{section.id}} .countdown__text-wrapper--content-alignment-left,
  #shopify-section-{{section.id}} .countdown__text-wrapper--content-alignment-right {
    text-align: left;
  }

  #shopify-section-{{section.id}} .countdown__text-wrapper--content-alignment-right {
    text-align: right;
  }
}

@media only screen and (min-width:412px){
  #shopify-section-{{section.id}} .countdown__block.countdown__block--content {
    flex: 1 1 35%;
    max-width: 35%;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--timer {
    flex: 1 1 40%;
    max-width: 40%;
    justify-content: center;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--button {
    flex: 1 1 25%;
    max-width: 25%;
    margin-top: 0;
  }
}

@media only screen and (min-width:500px){
  #shopify-section-{{section.id}} .countdown__block.countdown__block--content {
    flex: 1 1 50%;
    max-width: 50%;
    margin-bottom: 0;
  }

  #shopify-section-{{section.id}} .countdown__block--content .countdown__heading .aux_class {
    font-size: 16px;
  }

  #shopify-section-{{section.id}} .countdown__block--content .countdown__richtext p {
    font-size: 14px;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--timer {
    flex: 1 1 32%;
    max-width: 32%;
  }

  #shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block p {
    font-size: 18px;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--button {
    flex: 1 1 18%;
    justify-content: center;
    max-width: 18%;
    margin-top: 0;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--button .btn {
    padding: 6px 10px;
    font-size: 12px;
  }
}

@media only screen and (min-width:768px){
  #shopify-section-{{section.id}} .countdown__content {
    gap: 10px 20px;
  }

  #shopify-section-{{section.id}} .countdown__block--content .countdown__heading .aux_class {
    font-size: 20px;
  }

  #shopify-section-{{section.id}} .countdown__block--content .countdown__richtext p {
    font-size: 18px;
  }

  #shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block p {
    font-size: 20px;
  }

  #shopify-section-{{section.id}} .countdown__block--timer .countdown__display-block span {
    font-size: 10px;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--button .btn {
    font-size: 14px;
  }

  #shopify-section-{{section.id}} .countdown-arrow {
    right: 1%;
  }

  #shopify-section-{{section.id}} .countdown__block.countdown__block--content,
  #shopify-section-{{section.id}} .countdown__block.countdown__block--timer,
  #shopify-section-{{section.id}} .countdown__block.countdown__block--button {
    flex: auto;
    max-width: fit-content;
  }

  #shopify-section-{{section.id}} .countdown__richtext p:nth-child(1),
  #shopify-section-{{section.id}} .countdown__heading p.aux_class:nth-child(1){
    display: block;
  }

  #shopify-section-{{section.id}} .countdown__richtext p:nth-child(2),
  #shopify-section-{{section.id}} .countdown__heading p.aux_class:nth-child(2) {
    display: none;
  }

  #shopify-section-{{section.id}} .countdown-arrow {
    top: 35%;
  }

  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--content,
  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--timer,
  #shopify-section-{{section.id}} .two-block .countdown__block.countdown__block--button {
    flex: 1 1 auto;
    max-width: max-content;
  }

  #shopify-section-{{section.id}} .countdown__content {
    margin: 0 auto;
    width: fit-content;
  }
}

#shopify-section-{{section.id}} .countdown-arrow.closed {
  display: none;
}

</style>
<countdown-element class="bso-countdown countdown-arrow-wrapper {% if section.settings.hide_when_timer_ends %}removable{% endif %} {% if section.settings.show_close_button %}has-close-btn{% endif %}{% if section.settings.sticky == 'sticky_top' %}arrow-wrapper-top{% endif %}">
  <div
    id="countdown-wrapper-{{ section.id }}"
    class="
      countdown-wrapper
      countdown-layout--banner
      countdown-blocks--{{ section.blocks.size }}
      {% if section.blocks.size > 2 and section.blocks[0].type == 'content' and section.blocks[1].type == 'button' %}
        countdown-blocks--2 content-block-has-button-below
        {% assign button_block_hidden = true %}
      {% endif %}
      {% if section.settings.background_image != blank %}
        countdown__background-image--true
      {% else %}
        countdown__background-image--false
      {% endif %}
      {% if section.settings.mobile_image != blank %}
        countdown__mobile-image--true
      {% else %}
        countdown__mobile-image--false
      {% endif %}
    "
    style="
      {% if text_color_alpha != 0 %}
        --countdown-text-color: {{ section.settings.text_color }};
      {% else %}
        --countdown-text-color: var(--colorTextBody);
      {% endif %}
      {% if background_color_alpha != 0 %}
        --countdown-background-color: {{ section.settings.background_color }};
      {% else %}
        --countdown-background-color: var(--colorBody);
      {% endif %}
      --accent-color: {{ accent_color }}
    "
  >
    <div
      class="countdown__content {% if section.blocks.size == 1 %}single-block{% elsif section.blocks.size == 2 %}two-block{% endif %}">
      {% if section.settings.background_image != blank %}
        <div class="countdown__background-image-wrapper {% if section.settings.mobile_image != blank %}small--hide{% endif %}">
          {% comment %} Full width image so don't need to adjust sizes attribute, fallback is 100vw {% endcomment %}
          {%- render 'image-element',
            img: section.settings.background_image,
            img_width: 2400,
            loading: section.settings.lazyload_images,
            classes: 'countdown__background-image',
          -%}
          {% if section.settings.overlay_opacity > 0 %}
            {% assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 %}
              <div
                class="
                  countdown__overlay
                  {% if section.settings.mobile_image != blank %}small--hide{% endif %}
                "
                style="
                  --countdown-overlay-rgba: {{ section.settings.overlay_color  | color_modify: 'alpha', overlay_alpha }}
                "
              ></div>
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.mobile_image != blank %}
        <div class="countdown__mobile-image-wrapper">
          {% comment %} Full width image so don't need to adjust sizes attribute, fallback is 100vw {% endcomment %}
          {%- render 'image-element',
            img: section.settings.mobile_image,
            loading: section.settings.lazyload_images,
            classes: 'countdown__mobile-image medium-up--hide',
          -%}
          {% if section.settings.overlay_opacity > 0 %}
            {% assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 %}
              <div
                class="countdown__overlay medium-up--hide"
                style="
                  --countdown-overlay-rgba: {{ section.settings.overlay_color  | color_modify: 'alpha', overlay_alpha }}
                "
              ></div>
          {% endif %}
        </div>
      {% endif %}
      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          <div class="countdown__block countdown__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- render block -%}
          </div>
        {% endif %}
        {% if block.type == 'timer' %}
          <div class="countdown__block countdown__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {% unless block.settings.show_success_message %}
              <style>
                #shopify-section-{{section.id}} .bso-countdown.removable .hide-countdown-wrapper {
                  display: none !important;
                }
              </style>
            {% endunless %}
            <countdown-timer
              data-year="{{ block.settings.year }}"
              data-month="{{ block.settings.month }}"
              data-day="{{ block.settings.day }}"
              data-hour="{{ block.settings.hour }}"
              data-minute="{{ block.settings.minute }}"
              data-hide-timer="true"
              data-complete-message="{{ block.settings.text }}"
            >
              <div class="countdown__display countdown__display--visible" data-time-display>
                <div class="countdown__display-block timer">
                  <p class="aux_class h2 {% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 and button_block_hidden == false %}h3{% endif %}" date-days-placeholder>-</p>
                  <span>Tage</span>
                </div>
                <div class="countdown__display-block separator">:</div>
                <div class="countdown__display-block timer">
                  <p class="aux_class h2 {% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 and button_block_hidden == false %}h3{% endif %}" date-hours-placeholder>-</p>
                  <span>Stunden</span>
                </div>
                <div class="countdown__display-block separator">:</div>
                <div class="countdown__display-block timer">
                  <p class="aux_class h2 {% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 and button_block_hidden == false %}h3{% endif %}" date-minutes-placeholder>-</p>
                <span>Min.</span>
                </div>
                <div class="countdown__display-block separator">:</div>
                <div class="countdown__display-block timer">
                  <p class="aux_class h2 {% if section.blocks.size == 1 %}h1{% elsif section.blocks.size == 3 and button_block_hidden == false %}h3{% endif %}" date-seconds-placeholder>-</p>
                  <span>Sek.</span>
                </div>
              </div>
              {% if block.settings.text != blank %}
                <div class="countdown__timer-message" data-message-placeholder>{{ block.settings.text }}</div>
              {% endif %}
            </countdown-timer>
          </div>
        {% endif %}
        {% if block.type == 'content' %}
          <style>
            #shopify-section-{{section.id}} .countdown__block--content .countdown__heading .aux_class {
              font-size: {{ block.settings.heading_mobile_font_size }}px;
            }

            #shopify-section-{{section.id}} .countdown__block--content .countdown__richtext p {
              font-size: {{ block.settings.text_mobile_font_size }}px;
            }
            @media only screen and (min-width:768px){
              #shopify-section-{{section.id}} .countdown__block--content .countdown__heading .aux_class {
                font-size: {{ block.settings.heading_desktop_font_size }}px;
              }

              #shopify-section-{{section.id}} .countdown__block--content .countdown__richtext p {
                font-size: {{ block.settings.text_desktop_font_size }}px;
              }
            }
          </style>
          <div class="countdown__block countdown__block--{{ block.type }}" {{ block.shopify_attributes }}>
            <div class="countdown__text-wrapper countdown__text-wrapper--content-alignment-{{ block.settings.content_alignment }}">
              <div class="countdown__heading">
                <p class="aux_class h2 block--{{block.id}}">{{ block.settings.heading_desktop }}</p>
                <p class="aux_class h2 block--{{block.id}}">{{ block.settings.heading_mobile }}</p>
              </div>
              <div class="countdown__richtext">
                {{ block.settings.text_desktop }}
                {{ block.settings.text_mobile }}
              </div>
              {% if section.blocks.size > 2 and section.blocks[0].type == 'content' and section.blocks[1].type == 'button' %}
                <div class="countdown__block countdown__block--button">
                  <a
                    class="countdown__button btn btn--{{ section.blocks[1].settings.button_style }}"
                    href="{{ section.blocks[1].settings.button_link }}"
                  >
                    {{ section.blocks[1].settings.button }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% if block.type == 'button' and button_block_hidden == blank %}
        <div class="countdown__block countdown__block--{{ block.type }} button-block-active {% if section.settings.show_close_button != true %}center{% endif %}" {{ block.shopify_attributes }}  >
            <style>
              #shopify-section-{{section.id}} .btn{
                background: {{block.settings.button_color}};
              }
            
              #shopify-section-{{section.id}} .btn:hover{
                background: {{block.settings.button_color}};
              }
            </style>
            <a
              class="copy countdown__button btn btn--{{ block.settings.button_style }}"
              href="{{ block.settings.button_link}}"
            >
              {{ block.settings.button }}
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.settings.show_close_button %}
    <div id="arrow-{{section.id}}" class="countdown-arrow">
      <i>
        <svg fill="{{section.settings.text_color}}" height="25px" width="25px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" 
          viewBox="0 0 460.775 460.775" xml:space="preserve">
          <path d="M285.08,230.397L456.218,59.27c6.076-6.077,6.076-15.911,0-21.986L423.511,4.565c-2.913-2.911-6.866-4.55-10.992-4.55
            c-4.127,0-8.08,1.639-10.993,4.55l-171.138,171.14L59.25,4.565c-2.913-2.911-6.866-4.55-10.993-4.55
            c-4.126,0-8.08,1.639-10.992,4.55L4.558,37.284c-6.077,6.075-6.077,15.909,0,21.986l171.138,171.128L4.575,401.505
            c-6.074,6.077-6.074,15.911,0,21.986l32.709,32.719c2.911,2.911,6.865,4.55,10.992,4.55c4.127,0,8.08-1.639,10.994-4.55
            l171.117-171.12l171.118,171.12c2.913,2.911,6.866,4.55,10.993,4.55c4.128,0,8.081-1.639,10.992-4.55l32.709-32.719
            c6.074-6.075,6.074-15.909,0-21.986L285.08,230.397z"/>
        </svg>
      </i>
    </div>
  {% endif %}
</countdown-element>

<script>
  function copyCode(textToCopy) {
    // Create a temporary textarea element
    var textArea = document.createElement("textarea");
    textArea.value = textToCopy;

    // Append the textarea element to the DOM
    document.body.appendChild(textArea);

    // Select the text in the textarea
    textArea.select();
    textArea.setSelectionRange(0, 99999); // For mobile devices

    // Copy the text to the clipboard
    document.execCommand("copy");

    // Remove the temporary textarea element
    document.body.removeChild(textArea);

    // Optionally, you can provide some feedback to the user
    alert("Copied: " + textToCopy);
  }
</script>

{% schema %}
{
  "name": "BSO Announcement bar",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.countdown.settings.text_color.label",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.countdown.settings.background_color.label",
      "default": "#FFF",
      "info": "t:sections.countdown.settings.background_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_background_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.countdown.settings.background_image.label"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.countdown.settings.overlay_color.label",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.countdown.settings.overlay_opacity.label",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.countdown.settings.mobile_image.label"
    },
    {
      "type": "checkbox",
      "id": "lazyload_images",
      "label": "t:common.lazyload_images.label",
      "info": "t:common.lazyload_images.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_when_timer_ends",
      "label": "Hide the section when timer ends",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "timer",
      "name": "t:sections.countdown.blocks.timer.name",
      "settings": [
        {
          "type": "select",
          "id": "year",
          "label": "t:sections.countdown.blocks.timer.settings.year.label",
          "default": "2025",
          "options": [
            {
              "value": "2023",
              "label": "2023"
            },
            {
              "value": "2024",
              "label": "2024"
            },
            {
              "value": "2025",
              "label": "2025"
            },
            {
              "value": "2026",
              "label": "2026"
            }
          ]
        },
        {
          "type": "select",
          "id": "month",
          "label": "t:sections.countdown.blocks.timer.settings.month.label",
          "default": "01",
          "options": [
            {
              "value": "01",
              "label": "t:sections.countdown.blocks.timer.settings.month.options.01.label"
            },
            {
              "value": "02",
              "label": "t:sections.countdown.blocks.timer.settings.month.options.02.label"
            },
            {
              "value": "03",
              "label": "t:sections.countdown.blocks.timer.settings.month.options.03.label"
            },
