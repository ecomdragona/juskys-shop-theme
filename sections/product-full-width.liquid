      ]
    },
    {
      "type": "custom",
      "name": "t:sections.product-full-width.blocks.html.name",
      "settings": [
        {
          "type": "liquid",
          "id": "code",
          "label": "t:sections.product-full-width.blocks.html.settings.code.label",
