{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .bso-collection-intro-text__subheading {
    font-size: 15px;
    margin-top: 3px;
  }
  
  #shopify-section-{{ section.id }} .bso-collection-intro-text__subheading .visibility-hidden {
    visibility: hidden;
    display: none;
  }

  #shopify-section-{{ section.id }} .bso-collection-intro-text__text {
    margin-top: 10px;
  }
{%- endstyle -%}
<div class="page-width">
  <div class="bso-collection-intro-text">
    <div class="bso-collection-intro-text__content">
      <h1 class="bso-collection-intro-text__heading">
        {% if section.settings.heading != blank %}
          {{ section.settings.heading }}
        {% else %}
          {% if collection.metafields.custom.kategorie_titel != blank %}
            {{ collection.metafields.custom.kategorie_titel }}
          {% else %}
            {{ collection.title }}
          {% endif %}
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="bso-collection-intro-text__subheading">
            <span class="visibility-hidden">-</span>
            {{ section.settings.subheading }}
          </p>
        {% else %}
          {% if collection.metafields.custom.subheadhing != blank %}
            <p class="bso-collection-intro-text__subheading">
              <span class="visibility-hidden">-</span>
              {{ collection.metafields.custom.subheadhing }}
            </p>
          {% endif %}
        {% endif %}
      </h1>

      {% if section.settings.introtext != blank %}
        <div class="bso-collection-intro-text__text rte">
          {{ section.settings.introtext }}
        </div>
      {% else %}
        {% if collection.metafields.custom.introtext != blank %}
          <div class="bso-collection-intro-text__text rte">
            {{ collection.metafields.custom.introtext | metafield_tag }}
          </div>
        {% endif %}
      {% endif %}
      
      {% if section.settings.enable_readmore %}
        <div class="readmore-container">
          <a href="#mehr" class="bso-collection-intro-text__readmore scrollTo">» {{ 'general.readmore.more' | t }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "t:sections.bso_collection_intro_text.name",
    "class": "collection-intro-section",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.bso_collection_intro_text.settings.header.content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "t:sections.bso_collection_intro_text.settings.heading.label",
        "info": "t:sections.bso_collection_intro_text.settings.heading.info"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "t:sections.bso_collection_intro_text.settings.subheading.label",
        "info": "t:sections.bso_collection_intro_text.settings.subheading.info"
      },
      {
        "type": "richtext",
        "id": "introtext",
        "label": "t:sections.bso_collection_intro_text.settings.introtext.label",
        "info": "t:sections.bso_collection_intro_text.settings.introtext.info"
      },
      {
        "type": "checkbox",
        "id": "enable_readmore",
        "label": "Weiterlese Button aktivieren",
        "default": false
      },
      {
        "type": "header",
        "content": "t:sections.bso_collection_intro_text.settings.section_space.content"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.bso_collection_intro_text.settings.padding_top.label",
        "default": 25
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:sections.bso_collection_intro_text.settings.padding_bottom.label",
        "default": 25
      }
    ],
    "presets": [
      {
        "name": "t:sections.bso_collection_intro_text.name",
        "settings": {}
      }
    ]
  }
{% endschema %}