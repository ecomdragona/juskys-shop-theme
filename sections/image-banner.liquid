{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media(max-width : 768px ) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<style>
  .new-faq-banner-section {
    position: relative;
  }

  .nbanner-image-mobile-container {
    display: none;
  }

  .nbanner-image-desktop-container img {
    width: 100%;
    max-height: 430px;
    display: block;
    object-fit: cover;
  }

  .heading {
    position: absolute;
    top: 100px;
    left: 0;
    right: 0;
    padding: 60px 16px;
  }

  .heading h1 {
    font-size: 48px;
    line-height: 1.22;
    text-align: center;
    font-weight: normal;
    margin-bottom: 70px;
    text-transform: uppercase;
    color: #000000;
    letter-spacing: -0.5px;
  }

  @media screen and (max-width: 768px) {
    .nbanner-image-mobile-container img {
      max-height: 413px;
    }

    .heading {
      top: 0;
    }

    .heading h1 {
      font-size: 36px;
      margin-bottom: 20px;
      min-height: 180px;
    }
  }
</style>

<section class="new-faq-banner-section">
  <div class="nbanner-image-desktop-container">
    <img
      src="{{ section.settings.desktop_banner_image | img_url: "master" }}"
      width="100%"
      height="100%"
      alt="no img">
  </div>
  <div class="nbanner-image-mobile-container">
    <img
      src="{{ section.settings.mobile_banner_image | img_url: "master" }}"
      width="100%"
      height="100%"
      alt="no img">
  </div>
  <div class="heading">
    <h1>
      {{ section.settings.heading }}
    </h1>
  </div>
</section>

{% schema %}
  {
    "name": "New Faq Banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "desktop_banner_image",
        "label": "Desktop Banner Image"
      },
      {
        "type": "image_picker",
        "id": "mobile_banner_image",
        "label": "Mobile Banner Image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "Padding Top",
        "default": 50
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 50
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "MobilePadding Top",
        "default": 50
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "px",
        "label": "Mobile Padding Bottom",
        "default": 50
      }
    ],
    "presets": [
      {
        "name": "New Faq Banner"
      }
    ]
  }
{% endschema %}