      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const elements = document.querySelectorAll('.ruk-rating-snippet-count');
          elements.forEach(el => {
            const text = el.textContent.trim(); // e.g., "(175 Bewertungen)"
            const match = text.match(/\d+/); // extract the number
            if (match) {
              el.textContent = `(${match[0]})`; // set content to "(175)"
              console.log('Updated content:', el.textContent); // "(175)"
            }
          });
        }, 1000);
      });
